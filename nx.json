{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/src/**/__tests__/**",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.?(c|m)[jt]s",
      "!{projectRoot}/.spec.swcrc",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/backend/tsconfig.base.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": ["backend/**/*"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": ["backend/**/*"],
      "exclude": ["backend/eslint.config.mjs"]
    },
    "./front/tools/nx-plugin/index.cjs"
  ],
  "analytics": false,
  "targetDefaults": {
    "analyze": {
      "cache": true
    },
    "format-check": {
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.lib.json && tsc -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx backend/tools/app-bundler/src/main.ts {projectName} {projectRoot}",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/backend/tools/app-bundler/src/**/*",
        {
          "externalDependencies": ["esbuild", "@swc/core"]
        }
      ],
      "outputs": ["{workspaceRoot}/backend/dist/{projectName}"]
    }
  }
}
