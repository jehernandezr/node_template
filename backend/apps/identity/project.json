{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "identity",
  "sourceRoot": "backend/apps/identity/src",
  "projectType": "application",
  "tags": ["type:app", "scope:identity"],
  "targets": {
    "typecheck": {},
    "build": {
      "options": {
        "command": "tsx backend/tools/app-bundler/src/main.ts {projectName} {projectRoot} --entry=src/worker.ts --entry=src/migrate.ts --entry=src/seed.ts --entry=src/signing-keys.ts --entry=src/tenant-move.ts --entry=src/lambda.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/main.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "worker": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/worker.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/migrate.mjs {args.target}",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/seed.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "signing-keys": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/signing-keys.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "tenant-move": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=backend/.env backend/dist/identity/tenant-move.mjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
