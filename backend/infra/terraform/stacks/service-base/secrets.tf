# The secrets of the service (ADR 0041). This stack owns them, so they exist before the one-off tasks and the
# runtime of the service. A generated secret is an ephemeral random value written through a write-only attribute,
# so no value reaches the state. Identity also owns its signing-key container, filled by its signing-keys task, and,
# outside prod, the SMOKE_ACCOUNT container that only the deploy role writes before the seed (ADR 0043).

data "aws_partition" "current" {}

locals {
  identity              = local.svc == "identity"
  smoke_account_enabled = local.identity && var.environment != "prod"
  owns_secrets          = length(var.generated_secrets) > 0 || local.identity
  secret_name_prefix    = "${var.name_prefix}/${local.name}"

  # The role the deploy job assumes, created by the global stack of the account (modules/oidc-github).
  deploy_role_arn = "${local.account_role_arn_prefix}/${var.name_prefix}-github-deploy"

  stack_secrets = merge(
    { for name in var.generated_secrets : name => aws_secretsmanager_secret.generated[name].arn },
    local.identity ? { IDENTITY_SIGNING_KEYS = aws_secretsmanager_secret.signing_keys[0].arn } : {},
  )
  one_off_secrets = local.smoke_account_enabled ? { IDENTITY_SMOKE_ACCOUNT = aws_secretsmanager_secret.smoke_account[0].arn } : {}
}

module "secrets_kms" {
  count  = local.owns_secrets ? 1 : 0
  source = "../../modules/kms-key"

  alias       = "${var.name_prefix}-${local.name}-secrets"
  description = "Encryption of the secrets of ${local.svc} in ${var.name_prefix}"
}

ephemeral "random_password" "generated" {
  for_each = var.generated_secrets

  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = var.generated_secrets

  name                    = "${local.secret_name_prefix}/${lower(replace(each.key, "_", "-"))}"
  description             = "${each.key} of ${local.svc}, generated by Terraform"
  kms_key_id              = module.secrets_kms[0].arn
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = var.generated_secrets

  secret_id                = aws_secretsmanager_secret.generated[each.key].id
  secret_string_wo         = ephemeral.random_password.generated[each.key].result
  secret_string_wo_version = 1
}

# Created empty: the identity signing-keys task writes the first key set after the first apply of this stack and
# before the service stack, and the rotation runbook changes it afterwards.
resource "aws_secretsmanager_secret" "signing_keys" {
  count = local.identity ? 1 : 0

  name                    = "${local.secret_name_prefix}/signing-keys"
  description             = "IDENTITY_SIGNING_KEYS: ES256 private JWKs, filled by the identity signing-keys task"
  kms_key_id              = module.secrets_kms[0].arn
  recovery_window_in_days = var.secret_recovery_window_days
}

# Created empty, never in prod: the deploy job writes fresh credentials before every seed, and only the seed task
# receives them, as IDENTITY_SMOKE_ACCOUNT.
resource "aws_secretsmanager_secret" "smoke_account" {
  count = local.smoke_account_enabled ? 1 : 0

  name                    = "${local.secret_name_prefix}/smoke-account"
  description             = "SMOKE_ACCOUNT: email, password and TOTP secret of the smoke account, written by the deploy job"
  kms_key_id              = module.secrets_kms[0].arn
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_policy" "smoke_account" {
  count = local.smoke_account_enabled ? 1 : 0

  secret_arn          = aws_secretsmanager_secret.smoke_account[0].arn
  block_public_policy = true
  policy              = local.smoke_account_policy
}

locals {
  # The seed task reads the secret through its execution role. Its ARN is built from the name, which is known at
  # plan time, so the plan shows the whole policy.
  account_role_arn_prefix = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:role"
  smoke_account_readers   = [local.deploy_role_arn, "${local.account_role_arn_prefix}/${module.component["one-off"].execution_role_name}"]

  smoke_account_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "DeployRoleWritesAndReads"
        Effect    = "Allow"
        Principal = { AWS = local.deploy_role_arn }
        Action    = ["secretsmanager:PutSecretValue", "secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
        Resource  = "*"
      },
      {
        Sid       = "OnlyTheDeployRoleWrites"
        Effect    = "Deny"
        Principal = "*"
        Action    = ["secretsmanager:PutSecretValue", "secretsmanager:UpdateSecret", "secretsmanager:UpdateSecretVersionStage", "secretsmanager:RestoreSecret", "secretsmanager:PutResourcePolicy", "secretsmanager:DeleteResourcePolicy", "secretsmanager:DeleteSecret"]
        Resource  = "*"
        Condition = { StringNotEquals = { "aws:PrincipalArn" = local.deploy_role_arn } }
      },
      {
        Sid       = "OnlyTheDeployRoleAndTheSeedRead"
        Effect    = "Deny"
        Principal = "*"
        Action    = ["secretsmanager:GetSecretValue"]
        Resource  = "*"
        Condition = { StringNotEquals = { "aws:PrincipalArn" = local.smoke_account_readers } }
      },
    ]
  })

  # The signing-keys task runs with the one-off task role: it describes the container and writes its first value,
  # and never reads it.
  signing_keys_policy = local.identity ? jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "FillSigningKeys"
        Effect   = "Allow"
        Action   = ["secretsmanager:DescribeSecret", "secretsmanager:PutSecretValue"]
        Resource = aws_secretsmanager_secret.signing_keys[0].arn
      },
      {
        Sid      = "EncryptSigningKeys"
        Effect   = "Allow"
        Action   = ["kms:GenerateDataKey", "kms:Decrypt"]
        Resource = module.secrets_kms[0].arn
      },
    ]
  }) : null
}
