# Tests for the messaging stack with mocked providers: they touch neither AWS nor the backend.
# Run: terraform init -backend=false && terraform test

mock_provider "aws" {
  mock_data "aws_caller_identity" {
    defaults = { account_id = "123456789012" }
  }
  mock_data "aws_partition" {
    defaults = { partition = "aws" }
  }
}

variables {
  region        = "us-east-1"
  domain        = "example.test"
  regions       = { us = { aws_region = "us-east-1", api_base_url = "https://api.example.test", issuer = "https://api.example.test" } }
  web_origins   = ["https://app.example.test"]
  environment   = "dev"
  name_prefix   = "nt-dev"
  state_bucket  = "nt-dev-tfstate"
  topology_file = "tests/fixtures/topology.json"
}

override_data {
  target = data.terraform_remote_state.platform
  values = {
    outputs = {
      alarm_topic_arn = null
      ses             = null
    }
  }
}

run "permissions_come_from_the_topology" {
  command = plan

  assert {
    condition     = tolist(module.messaging.service_access["identity"].publish_topics) == tolist(["identity-events"])
    error_message = "identity publishes to the topics where it is a producer."
  }

  assert {
    condition     = tolist(module.messaging.service_access["tasks"].send_queues) == tolist(["reports-commands"])
    error_message = "tasks sends to the queues where it is a producer."
  }

  assert {
    condition     = tolist(module.messaging.service_access["notifications"].consume_queues) == tolist(["notifications-identity-events"])
    error_message = "notifications consumes the queue where it is a consumer."
  }

  assert {
    condition     = length(aws_sqs_queue.ses_events) == 0
    error_message = "Without SES there is no email events queue."
  }
}

run "generated_topology_grants_its_producers" {
  command = plan

  variables {
    topology_file = "../../topology.json"
  }

  # topology.json is generated by contracts-export from the contracts: identity publishes
  # to its events topic.
  assert {
    condition     = contains(keys(module.messaging.service_access), "identity")
    error_message = "The producer of the identity topic must be granted permission to publish."
  }
}
