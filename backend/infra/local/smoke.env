# Settings of the local smoke stack (smoke.compose.yml), read by backend/infra/scripts/local-smoke-cli.mjs.
# SMOKE_ACCOUNT is the fixed local smoke account: identity's seed receives it as IDENTITY_SMOKE_ACCOUNT and the
# deploy-smoke suite signs in with it. It only works on this local stack; a deploy writes fresh values instead.
SMOKE_ACCOUNT={"email":"success@simulator.amazonses.com","password":"local smoke account passphrase","totpSecret":"SMOKESMOKESMOKESMOKESMOKESMOKE22"}
SMOKE_GATEWAY_PORT=18480
