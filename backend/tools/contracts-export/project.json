{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "contracts-export",
  "sourceRoot": "backend/tools/contracts-export/src",
  "projectType": "application",
  "tags": ["type:tool", "scope:shared"],
  "implicitDependencies": [
    "contracts-platform",
    "contracts-identity",
    "contracts-tasks",
    "contracts-notifications",
    "contracts-reports",
    "contracts-billing"
  ],
  "targets": {
    "typecheck": {},
    "export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/contracts-export/tsconfig.lib.json tools/contracts-export/src/main.ts export",
        "cwd": "{workspaceRoot}/backend"
      },
      "cache": false
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/contracts-export/tsconfig.lib.json tools/contracts-export/src/main.ts check",
        "cwd": "{workspaceRoot}/backend"
      },
      "inputs": [
        "{workspaceRoot}/backend/libs/contracts/**/*",
        "{workspaceRoot}/backend/infra/terraform/topology.json",
        "{workspaceRoot}/.prettierrc",
        "{projectRoot}/src/**/*",
        {
          "externalDependencies": ["zod", "prettier"]
        }
      ],
      "cache": true
    },
    "topology-export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/contracts-export/tsconfig.lib.json tools/contracts-export/src/main.ts topology-export",
        "cwd": "{workspaceRoot}/backend"
      },
      "cache": false
    },
    "topology-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/contracts-export/tsconfig.lib.json tools/contracts-export/src/main.ts topology-check",
        "cwd": "{workspaceRoot}/backend"
      },
      "inputs": [
        "{workspaceRoot}/backend/libs/contracts/**/*",
        "{workspaceRoot}/backend/infra/terraform/topology.json",
        "{workspaceRoot}/.prettierrc",
        "{projectRoot}/src/**/*",
        {
          "externalDependencies": ["zod", "prettier"]
        }
      ],
      "cache": true
    }
  }
}
