{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "platform",
    "version": "2",
    "description": "Contract kit and cross-cutting pieces: identifiers, pagination, amounts, dates, user references, tenant directory and move, and errors."
  },
  "paths": {},
  "components": {
    "schemas": {
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
        "description": "UUIDv7 identifier."
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "description": "ISO 8601 instant in UTC."
      },
      "Cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Opaque pagination cursor."
      },
      "PageLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Page size."
      },
      "PageQuery": {
        "type": "object",
        "properties": {
          "limit": { "$ref": "#/components/schemas/PageLimit" },
          "after": { "$ref": "#/components/schemas/Cursor" }
        },
        "additionalProperties": false,
        "description": "Cursor pagination parameters."
      },
      "CurrencyCode": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "ISO 4217 currency code."
      },
      "MoneyAmount": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "currency": { "$ref": "#/components/schemas/CurrencyCode" }
        },
        "required": ["amountMinor", "currency"],
        "description": "Amount in minor units of the currency."
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "maxLength": 512 },
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "maxLength": 1024 }
        },
        "required": ["code"],
        "description": "Error of a field."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "traceId": { "type": "string" },
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FieldError" }
          },
          "details": {
            "type": "object",
            "properties": {
              "apiBaseUrl": { "type": "string", "maxLength": 2048 },
              "region": { "type": "string", "maxLength": 64 }
            },
            "description": "Public error data, for example the URL of the tenant region."
          }
        },
        "required": ["type", "title", "status", "code"],
        "description": "RFC 9457 error response."
      },
      "Empty": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Request without fields."
      },
      "CalendarDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Calendar date YYYY-MM-DD, without time or zone."
      },
      "UserRef": {
        "type": "object",
        "properties": {
          "userId": { "$ref": "#/components/schemas/Id" },
          "homeTenantId": { "$ref": "#/components/schemas/Id" }
        },
        "required": ["userId", "homeTenantId"],
        "description": "Reference to a user with their home tenant."
      },
      "TenantMoveRef": {
        "type": "object",
        "properties": {
          "moveId": { "$ref": "#/components/schemas/Id" },
          "tenantId": { "$ref": "#/components/schemas/Id" },
          "targetGroup": { "type": "string", "minLength": 1, "maxLength": 64 },
          "targetRegion": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "required": ["moveId", "tenantId", "targetGroup", "targetRegion"],
        "additionalProperties": false,
        "description": "Move of a tenant to another shard group or region."
      },
      "TenantMoveTableProgress": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "minLength": 1, "maxLength": 63 },
          "copiedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pendingRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["table", "copiedRows", "pendingRows"],
        "description": "Copy progress of a table."
      },
      "TenantMoveProgress": {
        "type": "object",
        "properties": {
          "tables": {
            "maxItems": 64,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TenantMoveTableProgress" }
          },
          "caughtUp": { "type": "boolean" }
        },
        "required": ["tables", "caughtUp"],
        "description": "Result of a copy round."
      },
      "TenantMoveTableCheck": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "minLength": 1, "maxLength": 63 },
          "sourceRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "targetRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sourceChecksum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "targetChecksum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "table",
          "sourceRows",
          "targetRows",
          "sourceChecksum",
          "targetChecksum"
        ],
        "description": "Count and checksum of a table in the source and the target."
      },
      "TenantMoveVerification": {
        "type": "object",
        "properties": {
          "verified": { "type": "boolean" },
          "tables": {
            "maxItems": 64,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TenantMoveTableCheck" }
          }
        },
        "required": ["verified", "tables"],
        "description": "Result of the last round and the verification of a move."
      },
      "TenantMoveAck": {
        "type": "object",
        "properties": { "moveId": { "$ref": "#/components/schemas/Id" } },
        "required": ["moveId"],
        "description": "Acknowledgement of a move cancellation or cleanup."
      },
      "TenantDirectoryEntry": {
        "type": "object",
        "properties": {
          "tenantId": { "$ref": "#/components/schemas/Id" },
          "region": { "type": "string", "minLength": 1, "maxLength": 64 },
          "groups": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "dedicated": { "type": "boolean" }
        },
        "required": ["tenantId", "region", "groups", "dedicated"],
        "additionalProperties": false,
        "description": "Location of a tenant that each service records in its shard directory."
      },
      "TenantDirectoryRef": {
        "type": "object",
        "properties": { "tenantId": { "$ref": "#/components/schemas/Id" } },
        "required": ["tenantId"],
        "additionalProperties": false,
        "description": "Tenant whose row is removed from the directory of a service."
      },
      "TenantDirectoryAck": {
        "type": "object",
        "properties": { "tenantId": { "$ref": "#/components/schemas/Id" } },
        "required": ["tenantId"],
        "description": "Acknowledgement of the placement or removal of a tenant in the directory of a service."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
