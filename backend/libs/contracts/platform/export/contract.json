  "constants": {
    "Pagination": {
      "defaultLimit": 20,
      "maxLimit": 100,
      "maxCursorLength": 512,
      "cursorPattern": "^[A-Za-z0-9_-]+$"
    },
    "MoneyLimits": {
      "maxAbsAmountMinor": 9007199254740991,
      "currencyPattern": "^[A-Z]{3}$"
    },
    "IdentifierFormat": {
      "version": 7,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ValidationRules": {
      "fieldPathSeparator": ".",
      "messageKeyPrefix": "error_"
    }
  },
  "schemas": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "Identificador UUIDv7."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Instante ISO 8601 en UTC."
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Cursor opaco de paginación."
    },
    "PageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Tamaño de página."
    },
    "PageQuery": {
      "type": "object",
      "properties": {
        "limit": { "$ref": "#/schemas/PageLimit" },
        "after": { "$ref": "#/schemas/Cursor" }
      },
      "additionalProperties": false,
      "description": "Parámetros de paginación por cursor."
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Código de moneda ISO 4217."
    },
    "MoneyAmount": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "currency": { "$ref": "#/schemas/CurrencyCode" }
      },
      "required": ["amountMinor", "currency"],
      "description": "Monto en unidades menores de la moneda."
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "field": { "type": "string", "maxLength": 512 },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1024 }
      },
      "required": ["code"],
      "description": "Error de un campo."
    },
    "ProblemDetails": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceId": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/schemas/FieldError" }
        }
      },
      "required": ["type", "title", "status", "code"],
      "description": "Respuesta de error RFC 9457."
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "description": "Petición sin campos."
    }
  },
