{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "billing",
    "version": "2",
    "description": "Billing: plans, tenant subscription, usage metering, entitlements, quotas, invoices and delinquency."
  },
  "paths": {
    "/v1/billing/subscription": {
      "get": {
        "operationId": "billing.subscription.get",
        "description": "Gets the tenant subscription with its plan.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.SUBSCRIPTION.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.SUBSCRIPTION.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:read"]
      }
    },
    "/v1/billing/usage": {
      "get": {
        "operationId": "billing.usage.get",
        "description": "Gets the current period usage of each metric with a quota.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsageOverview" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.SUBSCRIPTION.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.SUBSCRIPTION.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:read"]
      }
    },
    "/v1/billing/plans": {
      "get": {
        "operationId": "billing.plan.list",
        "description": "Lists the catalog plans with their price and limits.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanCatalog" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:read"]
      }
    },
    "/v1/billing/subscription/plan": {
      "put": {
        "operationId": "billing.subscription.change-plan",
        "description": "Changes the plan of the tenant subscription.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.VALIDATION.INVALID_INPUT, BILLING.SUBSCRIPTION.NOT_FOUND, BILLING.SUBSCRIPTION.NOT_CHANGEABLE, BILLING.PLAN.NOT_AVAILABLE, BILLING.PLAN.USAGE_EXCEEDS_LIMIT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.VALIDATION.INVALID_INPUT",
          "BILLING.SUBSCRIPTION.NOT_FOUND",
          "BILLING.SUBSCRIPTION.NOT_CHANGEABLE",
          "BILLING.PLAN.NOT_AVAILABLE",
          "BILLING.PLAN.USAGE_EXCEEDS_LIMIT"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePlanRequest" }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:write"]
      }
    },
    "/v1/billing/invoices": {
      "get": {
        "operationId": "billing.invoice.list",
        "description": "Lists the tenant invoices, with filter and pagination.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoicePage" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.VALIDATION.INVALID_INPUT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.VALIDATION.INVALID_INPUT"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:read"]
      }
    },
    "/v1/billing/invoices/{invoiceId}": {
      "get": {
        "operationId": "billing.invoice.get",
        "description": "Gets an invoice with its lines.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.INVOICE.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.INVOICE.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["billing:read"]
      }
    }
  },
  "components": {
    "schemas": {
      "UsageMetric": {
        "type": "string",
        "enum": ["users", "api_calls", "storage_gb"],
        "description": "Usage metric that has a quota."
      },
      "SubscriptionStatus": {
        "type": "string",
        "enum": ["trialing", "active", "past_due", "suspended", "canceled"],
        "description": "Status of a subscription."
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": ["draft", "issued", "paid", "failed", "void"],
        "description": "Status of an invoice."
      },
      "InvoiceLineKind": {
        "type": "string",
        "enum": ["fixed_fee", "usage"],
        "description": "Type of an invoice line."
      },
      "PlanPeriodicity": {
        "type": "string",
        "enum": ["monthly", "annual"],
        "description": "Billing interval of a plan."
      },
      "Currency": {
        "type": "string",
        "enum": ["COP", "USD"],
        "description": "Currency of the invoice."
      },
      "BillingPeriod": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/CalendarDate"
          },
          "end": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/CalendarDate"
          }
        },
        "required": ["start", "end"],
        "description": "Billing period with calendar dates."
      },
      "QuotaLimit": {
        "type": "object",
        "properties": {
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["metric", "limit"],
        "description": "Limit of a metric in a plan."
      },
      "UsageRecord": {
        "type": "object",
        "properties": {
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "windowStart": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "key": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["metric", "quantity", "windowStart", "key"],
        "additionalProperties": false,
        "description": "Usage of a metric in a window, with its idempotency key."
      },
      "RecordUsagePayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "records": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": { "$ref": "#/components/schemas/UsageRecord" }
          }
        },
        "required": ["tenantId", "records"],
        "additionalProperties": false,
        "description": "Batch of usage records of a tenant."
      },
      "SubscriptionChangedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "subscriptionId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "previousPlanId": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
              },
              { "type": "null" }
            ]
          },
          "planId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "changedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "subscriptionId",
          "previousPlanId",
          "planId",
          "changedAt"
        ],
        "description": "The plan of a subscription changed."
      },
      "SubscriptionSuspendedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "subscriptionId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "suspendedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": ["tenantId", "subscriptionId", "suspendedAt"],
        "description": "A subscription was suspended for non-payment."
      },
      "SubscriptionReactivatedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "subscriptionId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "reactivatedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": ["tenantId", "subscriptionId", "reactivatedAt"],
        "description": "A suspended subscription was reactivated."
      },
      "EntitlementsChangedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "features": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "../../identity/export/openapi.json#/components/schemas/PlanFeature"
            }
          },
          "quotas": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/QuotaLimit" }
          },
          "changedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": ["tenantId", "features", "quotas", "changedAt"],
        "description": "The active features or quotas of a tenant changed."
      },
      "InvoiceIssuedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "period": { "$ref": "#/components/schemas/BillingPeriod" },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "issuedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "invoiceId",
          "number",
          "period",
          "total",
          "issuedAt"
        ],
        "description": "An invoice was issued."
      },
      "InvoicePaidPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "paidAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": ["tenantId", "invoiceId", "number", "total", "paidAt"],
        "description": "An invoice was paid."
      },
      "InvoiceFailedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "failedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "invoiceId",
          "number",
          "total",
          "attempts",
          "failedAt"
        ],
        "description": "Charging an invoice failed."
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "price": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "periodicity": { "$ref": "#/components/schemas/PlanPeriodicity" },
          "quotas": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/QuotaLimit" }
          },
          "features": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "../../identity/export/openapi.json#/components/schemas/PlanFeature"
            }
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "periodicity",
          "quotas",
          "features"
        ],
        "description": "Catalog plan with its price and limits."
      },
      "PlanCatalog": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 20,
            "type": "array",
            "items": { "$ref": "#/components/schemas/Plan" }
          }
        },
        "required": ["items"],
        "description": "Catalog of available plans."
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "plan": { "$ref": "#/components/schemas/Plan" },
          "status": { "$ref": "#/components/schemas/SubscriptionStatus" },
          "period": { "$ref": "#/components/schemas/BillingPeriod" }
        },
        "required": ["id", "plan", "status", "period"],
        "description": "Tenant subscription with its plan and current period."
      },
      "QuotaUsage": {
        "type": "object",
        "properties": {
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["metric", "limit", "used"],
        "description": "Usage of a metric against its limit."
      },
      "UsageOverview": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/QuotaUsage" }
          }
        },
        "required": ["items"],
        "description": "Current period usage of each metric with a quota."
      },
      "InvoiceLine": {
        "type": "object",
        "properties": {
          "kind": { "$ref": "#/components/schemas/InvoiceLineKind" },
          "description": { "type": "string", "minLength": 1, "maxLength": 200 },
          "amount": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          }
        },
        "required": ["kind", "description", "amount"],
        "description": "Invoice line."
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "period": { "$ref": "#/components/schemas/BillingPeriod" },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "lines": {
            "maxItems": 200,
            "type": "array",
            "items": { "$ref": "#/components/schemas/InvoiceLine" }
          },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          }
        },
        "required": [
          "id",
          "number",
          "period",
          "status",
          "currency",
          "lines",
          "total"
        ],
        "description": "Full invoice with its lines."
      },
      "InvoiceSummary": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "period": { "$ref": "#/components/schemas/BillingPeriod" },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          }
        },
        "required": ["id", "number", "period", "status", "currency", "total"],
        "description": "Invoice without lines, for listings."
      },
      "InvoicePage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/InvoiceSummary" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of invoices, newest first."
      },
      "ChangePlanRequest": {
        "type": "object",
        "properties": {
          "planId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["planId"],
        "additionalProperties": false,
        "description": "Plan the subscription changes to."
      },
      "ListInvoicesRequest": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "limit": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/PageLimit"
          },
          "after": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination of the invoice listing."
      },
      "GetInvoiceRequest": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["invoiceId"],
        "additionalProperties": false,
        "description": "Invoice to query."
      },
      "OpenBillingAccountInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "ownerUserId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId", "ownerUserId"],
        "additionalProperties": false,
        "description": "Opens the billing account of a new tenant."
      },
      "BillingAccountResult": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "subscriptionId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "status": { "$ref": "#/components/schemas/SubscriptionStatus" }
        },
        "required": ["tenantId", "subscriptionId", "status"],
        "description": "Billing account opened with its subscription."
      },
      "CloseBillingAccountInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId"],
        "additionalProperties": false,
        "description": "Closes the billing account of a tenant."
      },
      "BillingAccountClosed": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId"],
        "description": "Billing account closed."
      },
      "GetEntitlementsInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId"],
        "additionalProperties": false,
        "description": "Tenant whose features and quotas are queried."
      },
      "Entitlements": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "status": { "$ref": "#/components/schemas/SubscriptionStatus" },
          "features": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "../../identity/export/openapi.json#/components/schemas/PlanFeature"
            }
          },
          "quotas": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/QuotaLimit" }
          }
        },
        "required": ["tenantId", "status", "features", "quotas"],
        "description": "Active features and quotas of a tenant."
      },
      "CheckQuotaInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "requested": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": ["tenantId", "metric"],
        "additionalProperties": false,
        "description": "Checks whether a tenant can consume an amount of a metric."
      },
      "QuotaCheck": {
        "type": "object",
        "properties": {
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "allowed": { "type": "boolean" }
        },
        "required": ["metric", "limit", "used", "allowed"],
        "description": "Result of a quota check."
      },
      "MarkInvoicePaidInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "paidAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "reference": { "type": "string", "minLength": 1, "maxLength": 120 },
          "amount": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "attemptId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId", "invoiceId", "paidAt", "reference", "amount"],
        "additionalProperties": false,
        "description": "Marks an invoice as paid with the provider reference."
      },
      "MarkInvoiceFailedInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "failedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "attemptId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId", "invoiceId", "failedAt"],
        "additionalProperties": false,
        "description": "Marks an invoice as failed after a declined charge."
      },
      "InvoiceStateResult": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" }
        },
        "required": ["invoiceId", "status"],
        "description": "Invoice status after the operation."
      },
      "InvoiceChange": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "number": { "type": "string", "minLength": 1, "maxLength": 32 },
          "period": { "$ref": "#/components/schemas/BillingPeriod" },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "total": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/MoneyAmount"
          },
          "issuedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "paidAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "number",
          "period",
          "status",
          "currency",
          "total",
          "issuedAt",
          "paidAt"
        ],
        "description": "Invoice with its issue and payment dates, to sync another service."
      },
      "InvoiceChangePage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/InvoiceChange" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of a tenant invoices, newest first."
      },
      "ListInvoiceChangesInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "limit": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/PageLimit"
          },
          "after": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
          }
        },
        "required": ["tenantId"],
        "additionalProperties": false,
        "description": "Input to page the invoices of a tenant."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
