      },
      "CheckQuotaInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
          "requested": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": ["tenantId", "metric"],
        "additionalProperties": false,
        "description": "Consulta si un tenant puede consumir una cantidad de una métrica."
      },
      "QuotaCheck": {
        "type": "object",
        "properties": {
          "metric": { "$ref": "#/components/schemas/UsageMetric" },
