  "commands": [
    {
      "name": "recordUsage",
      "type": "billing.usage.record.v1",
      "kind": "command",
      "version": 1,
      "payload": { "$ref": "#/schemas/RecordUsagePayload" },
      "description": "Registra el uso de un tenant medido por otro servicio. Cada registro lleva su llave de idempotencia."
