  "operations": [
    {
      "name": "openAccount",
      "id": "billing.accounts.open.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/OpenBillingAccountInput" },
      "output": { "$ref": "#/schemas/BillingAccountResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.accounts.close.v1",
      "errors": ["BILLING.PLAN.NOT_AVAILABLE"],
      "timeoutMs": 5000,
      "description": "Abre la cuenta de facturación de un tenant con su suscripción."
    },
    {
      "name": "closeAccount",
      "id": "billing.accounts.close.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/CloseBillingAccountInput" },
      "output": { "$ref": "#/schemas/BillingAccountClosed" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Solo corre como compensación de la apertura: sin factura emitida borra la suscripción y no hay nada que restaurar.",
      "errors": ["BILLING.INVOICE.INVALID_STATE"],
      "timeoutMs": 5000,
      "description": "Cierra la cuenta de facturación de un tenant."
    },
    {
      "name": "getEntitlements",
      "id": "billing.entitlements.get.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/GetEntitlementsInput" },
      "output": { "$ref": "#/schemas/Entitlements" },
      "idempotent": true,
      "mutating": false,
      "errors": ["BILLING.SUBSCRIPTION.NOT_FOUND"],
      "timeoutMs": 5000,
      "description": "Consulta las funcionalidades y cuotas vigentes de un tenant."
    },
    {
      "name": "checkQuota",
      "id": "billing.quotas.check.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/CheckQuotaInput" },
      "output": { "$ref": "#/schemas/QuotaCheck" },
      "idempotent": true,
      "mutating": false,
      "errors": ["BILLING.SUBSCRIPTION.NOT_FOUND"],
      "timeoutMs": 1000,
      "description": "Consulta si un tenant puede consumir una cantidad de una métrica."
    },
    {
      "name": "markInvoicePaid",
      "id": "billing.invoices.mark-paid.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/MarkInvoicePaidInput" },
      "output": { "$ref": "#/schemas/InvoiceStateResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "El pago ocurrió fuera de billing; un error se corrige con una nota, no con una reversa.",
      "errors": ["BILLING.INVOICE.NOT_FOUND", "BILLING.INVOICE.INVALID_STATE"],
      "timeoutMs": 5000,
      "description": "Marca una factura como pagada con la referencia del proveedor."
    },
    {
      "name": "markInvoiceFailed",
      "id": "billing.invoices.mark-failed.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/MarkInvoiceFailedInput" },
      "output": { "$ref": "#/schemas/InvoiceStateResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "El cobro falló fuera de billing; un error se corrige con una nota, no con una reversa.",
      "errors": ["BILLING.INVOICE.NOT_FOUND", "BILLING.INVOICE.INVALID_STATE"],
      "timeoutMs": 5000,
      "description": "Marca una factura como fallida después de un cobro rechazado."
    },
    {
      "name": "tenantMoveSync",
      "id": "billing.tenant-move.sync.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveProgress"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.tenant-move.abort.v1",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Copia un lote de los datos del tenant en billing al destino mientras las escrituras siguen; la saga repite hasta completar la ronda."
    },
    {
      "name": "tenantMoveFinalize",
      "id": "billing.tenant-move.finalize.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveVerification"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.tenant-move.abort.v1",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Copia la última ronda de billing con el tenant congelado y verifica conteos y sumas."
    },
    {
      "name": "tenantMoveAbort",
      "id": "billing.tenant-move.abort.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Solo corre como compensación de la copia: descarta lo copiado al destino y no hay nada que restaurar.",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Cancela el traslado de un tenant y descarta lo copiado de billing al destino."
    },
    {
      "name": "tenantMoveCleanup",
      "id": "billing.tenant-move.cleanup.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Borra del origen los datos ya trasladados una vez vencida la gracia: no se restauran.",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Borra de billing los datos del tenant trasladado cuando pasa el periodo de gracia."
    }
  ],
