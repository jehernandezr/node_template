{
  "$comment": "GENERADO por backend/tools/contracts-export. No editar: cambia el contrato en TypeScript y ejecuta pnpm nx run contracts-export:export.",
  "formatVersion": 2,
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "service": "billing",
  "description": "Facturación: planes, suscripción del tenant, medición de uso, entitlements, cuotas, facturas y morosidad.",
  "enums": {
    "SubscriptionStatus": {
      "values": [
        { "name": "Trialing", "value": "trialing" },
        { "name": "Active", "value": "active" },
        { "name": "PastDue", "value": "past_due" },
        { "name": "Suspended", "value": "suspended" },
        { "name": "Canceled", "value": "canceled" }
      ]
    },
    "InvoiceStatus": {
      "values": [
        { "name": "Draft", "value": "draft" },
        { "name": "Issued", "value": "issued" },
        { "name": "Paid", "value": "paid" },
        { "name": "Failed", "value": "failed" },
        { "name": "Void", "value": "void" }
      ]
    },
    "InvoiceLineKind": {
      "values": [
        { "name": "FixedFee", "value": "fixed_fee" },
        { "name": "Usage", "value": "usage" }
      ]
    },
    "PlanPeriodicity": {
      "values": [
        { "name": "Monthly", "value": "monthly" },
        { "name": "Annual", "value": "annual" }
      ]
    },
    "Currency": {
      "values": [
        { "name": "Cop", "value": "COP" },
        { "name": "Usd", "value": "USD" }
      ]
    },
    "UsageMetric": {
      "values": [
        { "name": "Users", "value": "users" },
        { "name": "ApiCalls", "value": "api_calls" },
        { "name": "StorageGb", "value": "storage_gb" }
      ]
    },
    "UsageAggregationKind": {
      "values": [
        { "name": "Max", "value": "max" },
        { "name": "Sum", "value": "sum" }
      ]
    },
    "BillingErrorCode": {
      "values": [
        {
          "name": "SubscriptionNotFound",
          "value": "BILLING.SUBSCRIPTION.NOT_FOUND"
        },
        {
          "name": "SubscriptionNotChangeable",
          "value": "BILLING.SUBSCRIPTION.NOT_CHANGEABLE"
        },
        { "name": "PlanNotAvailable", "value": "BILLING.PLAN.NOT_AVAILABLE" },
        {
          "name": "PlanUsageExceedsLimit",
          "value": "BILLING.PLAN.USAGE_EXCEEDS_LIMIT"
        },
        { "name": "InvoiceNotFound", "value": "BILLING.INVOICE.NOT_FOUND" },
        {
          "name": "InvoiceInvalidState",
          "value": "BILLING.INVOICE.INVALID_STATE"
        },
        { "name": "QuotaExceeded", "value": "BILLING.QUOTA.EXCEEDED" }
      ]
    },
    "BillingRoute": {
      "values": [
        { "name": "GetSubscription", "value": "billing.subscription.get" },
        { "name": "GetUsage", "value": "billing.usage.get" },
        { "name": "ListPlans", "value": "billing.plan.list" },
        { "name": "ChangePlan", "value": "billing.subscription.change-plan" },
        { "name": "ListInvoices", "value": "billing.invoice.list" },
        { "name": "GetInvoice", "value": "billing.invoice.get" }
      ]
    },
    "BillingOperation": {
      "values": [
        { "name": "OpenAccount", "value": "billing.accounts.open.v1" },
        { "name": "CloseAccount", "value": "billing.accounts.close.v1" },
        { "name": "GetEntitlements", "value": "billing.entitlements.get.v1" },
        { "name": "CheckQuota", "value": "billing.quotas.check.v1" },
        { "name": "MarkInvoicePaid", "value": "billing.invoices.mark-paid.v1" },
        {
          "name": "MarkInvoiceFailed",
          "value": "billing.invoices.mark-failed.v1"
        },
        { "name": "TenantMoveSync", "value": "billing.tenant-move.sync.v1" },
        {
          "name": "TenantMoveFinalize",
          "value": "billing.tenant-move.finalize.v1"
        },
        { "name": "TenantMoveAbort", "value": "billing.tenant-move.abort.v1" },
        {
          "name": "TenantMoveCleanup",
          "value": "billing.tenant-move.cleanup.v1"
        }
      ]
    },
    "BillingEvent": {
      "values": [
        {
          "name": "SubscriptionChanged",
          "value": "billing.subscription.changed.v1"
        },
        {
          "name": "SubscriptionSuspended",
          "value": "billing.subscription.suspended.v1"
        },
        {
          "name": "SubscriptionReactivated",
          "value": "billing.subscription.reactivated.v1"
        },
        {
          "name": "EntitlementsChanged",
          "value": "billing.entitlements.changed.v1"
        },
        { "name": "InvoiceIssued", "value": "billing.invoice.issued.v1" },
        { "name": "InvoicePaid", "value": "billing.invoice.paid.v1" },
        { "name": "InvoiceFailed", "value": "billing.invoice.failed.v1" }
      ]
    },
    "BillingCommand": {
      "values": [{ "name": "RecordUsage", "value": "billing.usage.record.v1" }]
    },
    "BillingTopic": {
      "values": [{ "name": "Events", "value": "billing-events" }]
    },
    "BillingQueue": {
      "values": [
        { "name": "Usage", "value": "billing-usage" },
        { "name": "Identity", "value": "billing-identity" }
      ]
    }
  },
  "constants": {
    "BillingLimits": {
      "planNameMaxLength": 120,
      "invoiceNumberMaxLength": 32,
      "invoiceDescriptionMaxLength": 200,
      "maxQuotasPerPlan": 10,
      "maxFeaturesPerPlan": 20,
      "maxLinesPerInvoice": 200,
      "usageKeyMaxLength": 200,
      "maxUsageRecordsPerBatch": 500,
      "maxUsageQuantity": 1000000000,
      "maxPlans": 20,
      "paymentReferenceMaxLength": 120,
      "failureReasonMaxLength": 200
    },
    "UsageAggregation": {
      "users": "max",
      "apiCalls": "sum",
      "storageGb": "max"
    }
  },
  "schemas": {
    "UsageMetric": {
      "type": "string",
      "enum": ["users", "api_calls", "storage_gb"],
      "description": "Métrica de uso que tiene cuota."
    },
    "SubscriptionStatus": {
      "type": "string",
      "enum": ["trialing", "active", "past_due", "suspended", "canceled"],
      "description": "Estado de una suscripción."
    },
    "InvoiceStatus": {
      "type": "string",
      "enum": ["draft", "issued", "paid", "failed", "void"],
      "description": "Estado de una factura."
    },
    "InvoiceLineKind": {
      "type": "string",
      "enum": ["fixed_fee", "usage"],
      "description": "Tipo de línea de una factura."
    },
    "PlanPeriodicity": {
      "type": "string",
      "enum": ["monthly", "annual"],
      "description": "Periodicidad de cobro de un plan."
    },
    "Currency": {
      "type": "string",
      "enum": ["COP", "USD"],
      "description": "Moneda en que se factura."
    },
    "BillingPeriod": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "../../platform/export/contract.json#/schemas/CalendarDate"
        },
        "end": {
          "$ref": "../../platform/export/contract.json#/schemas/CalendarDate"
        }
      },
      "required": ["start", "end"],
      "description": "Periodo de facturación con fechas de calendario."
    },
    "QuotaLimit": {
      "type": "object",
      "properties": {
        "metric": { "$ref": "#/schemas/UsageMetric" },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["metric", "limit"],
      "description": "Límite de una métrica en un plan."
    },
    "UsageRecord": {
      "type": "object",
      "properties": {
        "metric": { "$ref": "#/schemas/UsageMetric" },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "windowStart": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["metric", "quantity", "windowStart", "key"],
      "additionalProperties": false,
      "description": "Uso de una métrica en una ventana, con su llave de idempotencia."
    },
    "RecordUsagePayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "records": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": { "$ref": "#/schemas/UsageRecord" }
        }
      },
      "required": ["tenantId", "records"],
      "additionalProperties": false,
      "description": "Lote de registros de uso de un tenant."
    },
    "SubscriptionChangedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "subscriptionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "previousPlanId": {
          "anyOf": [
            { "$ref": "../../platform/export/contract.json#/schemas/Id" },
            { "type": "null" }
          ]
        },
        "planId": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "changedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": [
        "tenantId",
        "subscriptionId",
        "previousPlanId",
        "planId",
        "changedAt"
      ],
      "description": "Cambió el plan de una suscripción."
    },
    "SubscriptionSuspendedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "subscriptionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "suspendedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["tenantId", "subscriptionId", "suspendedAt"],
      "description": "Se suspendió una suscripción por falta de pago."
    },
    "SubscriptionReactivatedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "subscriptionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "reactivatedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["tenantId", "subscriptionId", "reactivatedAt"],
      "description": "Se reactivó una suscripción suspendida."
    },
    "EntitlementsChangedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "features": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "../../identity/export/contract.json#/schemas/PlanFeature"
          }
        },
        "quotas": {
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/schemas/QuotaLimit" }
        },
        "changedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["tenantId", "features", "quotas", "changedAt"],
      "description": "Cambiaron las funcionalidades o cuotas vigentes de un tenant."
    },
    "InvoiceIssuedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "period": { "$ref": "#/schemas/BillingPeriod" },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "issuedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": [
        "tenantId",
        "invoiceId",
        "number",
        "period",
        "total",
        "issuedAt"
      ],
      "description": "Se emitió una factura."
    },
    "InvoicePaidPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "paidAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["tenantId", "invoiceId", "number", "total", "paidAt"],
      "description": "Se pagó una factura."
    },
    "InvoiceFailedPayload": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "failedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": [
        "tenantId",
        "invoiceId",
        "number",
        "total",
        "attempts",
        "failedAt"
      ],
      "description": "Falló el cobro de una factura."
    },
    "Plan": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "price": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "periodicity": { "$ref": "#/schemas/PlanPeriodicity" },
        "quotas": {
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/schemas/QuotaLimit" }
        },
        "features": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "../../identity/export/contract.json#/schemas/PlanFeature"
          }
        }
      },
      "required": ["id", "name", "price", "periodicity", "quotas", "features"],
      "description": "Plan del catálogo con su precio y sus límites."
    },
    "PlanCatalog": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 20,
          "type": "array",
          "items": { "$ref": "#/schemas/Plan" }
        }
      },
      "required": ["items"],
      "description": "Catálogo de planes disponibles."
    },
    "Subscription": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "plan": { "$ref": "#/schemas/Plan" },
        "status": { "$ref": "#/schemas/SubscriptionStatus" },
        "period": { "$ref": "#/schemas/BillingPeriod" }
      },
      "required": ["id", "plan", "status", "period"],
      "description": "Suscripción del tenant con su plan y el periodo vigente."
    },
    "QuotaUsage": {
      "type": "object",
      "properties": {
        "metric": { "$ref": "#/schemas/UsageMetric" },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["metric", "limit", "used"],
      "description": "Uso de una métrica frente a su límite."
    },
    "UsageOverview": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/schemas/QuotaUsage" }
        }
      },
      "required": ["items"],
      "description": "Uso del periodo vigente de cada métrica con cuota."
    },
    "InvoiceLine": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/schemas/InvoiceLineKind" },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "amount": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        }
      },
      "required": ["kind", "description", "amount"],
      "description": "Línea de una factura."
    },
    "Invoice": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "period": { "$ref": "#/schemas/BillingPeriod" },
        "status": { "$ref": "#/schemas/InvoiceStatus" },
        "currency": { "$ref": "#/schemas/Currency" },
        "lines": {
          "maxItems": 200,
          "type": "array",
          "items": { "$ref": "#/schemas/InvoiceLine" }
        },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        }
      },
      "required": [
        "id",
        "number",
        "period",
        "status",
        "currency",
        "lines",
        "total"
      ],
      "description": "Factura completa con sus líneas."
    },
    "InvoiceSummary": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "period": { "$ref": "#/schemas/BillingPeriod" },
        "status": { "$ref": "#/schemas/InvoiceStatus" },
        "currency": { "$ref": "#/schemas/Currency" },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        }
      },
      "required": ["id", "number", "period", "status", "currency", "total"],
      "description": "Factura sin líneas, para listados."
    },
    "InvoicePage": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/schemas/InvoiceSummary" }
        },
        "nextCursor": {
          "anyOf": [
            { "$ref": "../../platform/export/contract.json#/schemas/Cursor" },
            { "type": "null" }
          ]
        }
      },
      "required": ["items", "nextCursor"],
      "description": "Página de facturas, más nuevas primero."
    },
    "ChangePlanRequest": {
      "type": "object",
      "properties": {
        "planId": { "$ref": "../../platform/export/contract.json#/schemas/Id" }
      },
      "required": ["planId"],
      "additionalProperties": false,
      "description": "Plan al que cambia la suscripción."
    },
    "ListInvoicesRequest": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/schemas/InvoiceStatus" },
        "limit": {
          "$ref": "../../platform/export/contract.json#/schemas/PageLimit"
        },
        "after": {
          "$ref": "../../platform/export/contract.json#/schemas/Cursor"
        }
      },
      "additionalProperties": false,
      "description": "Filtros y paginación del listado de facturas."
    },
    "GetInvoiceRequest": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["invoiceId"],
      "additionalProperties": false,
      "description": "Factura a consultar."
    },
    "OpenBillingAccountInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "ownerUserId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId", "ownerUserId"],
      "additionalProperties": false,
      "description": "Abre la cuenta de facturación de un tenant nuevo."
    },
    "BillingAccountResult": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "subscriptionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "status": { "$ref": "#/schemas/SubscriptionStatus" }
      },
      "required": ["tenantId", "subscriptionId", "status"],
      "description": "Cuenta de facturación abierta con su suscripción."
    },
    "CloseBillingAccountInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId"],
      "additionalProperties": false,
      "description": "Cierra la cuenta de facturación de un tenant."
    },
    "BillingAccountClosed": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId"],
      "description": "Cuenta de facturación cerrada."
    },
    "GetEntitlementsInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId"],
      "additionalProperties": false,
      "description": "Tenant cuyas funcionalidades y cuotas se consultan."
    },
    "Entitlements": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "status": { "$ref": "#/schemas/SubscriptionStatus" },
        "features": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "../../identity/export/contract.json#/schemas/PlanFeature"
          }
        },
        "quotas": {
          "maxItems": 10,
          "type": "array",
          "items": { "$ref": "#/schemas/QuotaLimit" }
        }
      },
      "required": ["tenantId", "status", "features", "quotas"],
      "description": "Funcionalidades y cuotas vigentes de un tenant."
    },
    "CheckQuotaInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "metric": { "$ref": "#/schemas/UsageMetric" },
        "requested": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      },
      "required": ["tenantId", "metric"],
      "additionalProperties": false,
      "description": "Consulta si un tenant puede consumir una cantidad de una métrica."
    },
    "QuotaCheck": {
      "type": "object",
      "properties": {
        "metric": { "$ref": "#/schemas/UsageMetric" },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allowed": { "type": "boolean" }
      },
      "required": ["metric", "limit", "used", "allowed"],
      "description": "Resultado de consultar una cuota."
    },
    "MarkInvoicePaidInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "paidAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "required": ["tenantId", "invoiceId", "paidAt", "reference"],
      "additionalProperties": false,
      "description": "Marca una factura como pagada con la referencia del proveedor."
    },
    "MarkInvoiceFailedInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "failedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["tenantId", "invoiceId", "failedAt"],
      "additionalProperties": false,
      "description": "Marca una factura como fallida después de un cobro rechazado."
    },
    "InvoiceStateResult": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "status": { "$ref": "#/schemas/InvoiceStatus" }
      },
      "required": ["invoiceId", "status"],
      "description": "Estado de una factura después de la operación."
    }
  },
