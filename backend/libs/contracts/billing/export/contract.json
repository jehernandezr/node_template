  "errors": {
    "BillingErrorCode": [
      {
        "name": "SubscriptionNotFound",
        "code": "BILLING.SUBSCRIPTION.NOT_FOUND",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_subscription_not_found",
        "description": "El tenant no tiene una suscripción."
      },
      {
        "name": "SubscriptionNotChangeable",
        "code": "BILLING.SUBSCRIPTION.NOT_CHANGEABLE",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_subscription_not_changeable",
        "description": "La suscripción está suspendida o cancelada y no admite cambio de plan."
      },
      {
        "name": "PlanNotAvailable",
        "code": "BILLING.PLAN.NOT_AVAILABLE",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_plan_not_available",
        "description": "El plan no existe o no está disponible para este tenant."
      },
      {
        "name": "PlanUsageExceedsLimit",
        "code": "BILLING.PLAN.USAGE_EXCEEDS_LIMIT",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_plan_usage_exceeds_limit",
        "description": "El uso actual supera un límite del plan nuevo: no se puede bajar a ese plan."
      },
      {
        "name": "InvoiceNotFound",
        "code": "BILLING.INVOICE.NOT_FOUND",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_invoice_not_found",
        "description": "La factura no existe en el tenant."
      },
      {
        "name": "InvoiceInvalidState",
        "code": "BILLING.INVOICE.INVALID_STATE",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_invoice_invalid_state",
        "description": "La factura no está en un estado que admita la operación pedida."
      },
      {
        "name": "QuotaExceeded",
        "code": "BILLING.QUOTA.EXCEEDED",
        "httpStatus": 403,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_quota_exceeded",
        "description": "Se alcanzó la cuota del plan. Los detalles traen metric, limit y used."
      }
    ]
  }
