          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 120 },
        "amount": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "attemptId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId", "invoiceId", "paidAt", "reference", "amount"],
      "additionalProperties": false,
      "description": "Marks an invoice as paid with the provider reference."
    },
    "MarkInvoiceFailedInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "failedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "attemptId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["tenantId", "invoiceId", "failedAt"],
      "additionalProperties": false,
      "description": "Marks an invoice as failed after a declined charge."
    },
    "InvoiceStateResult": {
      "type": "object",
      "properties": {
        "invoiceId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "status": { "$ref": "#/schemas/InvoiceStatus" }
      },
      "required": ["invoiceId", "status"],
      "description": "Invoice status after the operation."
    },
    "InvoiceChange": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "period": { "$ref": "#/schemas/BillingPeriod" },
        "status": { "$ref": "#/schemas/InvoiceStatus" },
        "currency": { "$ref": "#/schemas/Currency" },
        "total": {
          "$ref": "../../platform/export/contract.json#/schemas/MoneyAmount"
        },
        "issuedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "paidAt": {
          "anyOf": [
            {
              "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "id",
        "number",
        "period",
        "status",
        "currency",
        "total",
        "issuedAt",
        "paidAt"
      ],
      "description": "Invoice with its issue and payment dates, to sync another service."
    },
    "InvoiceChangePage": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/schemas/InvoiceChange" }
        },
        "nextCursor": {
          "anyOf": [
            { "$ref": "../../platform/export/contract.json#/schemas/Cursor" },
            { "type": "null" }
          ]
        }
      },
      "required": ["items", "nextCursor"],
      "description": "Page of a tenant invoices, newest first."
    },
    "ListInvoiceChangesInput": {
      "type": "object",
      "properties": {
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "limit": {
          "$ref": "../../platform/export/contract.json#/schemas/PageLimit"
        },
        "after": {
          "$ref": "../../platform/export/contract.json#/schemas/Cursor"
        }
      },
      "required": ["tenantId"],
      "additionalProperties": false,
      "description": "Input to page the invoices of a tenant."
    }
  },
  "routes": [
    {
      "name": "getSubscription",
      "id": "billing.subscription.get",
      "method": "GET",
      "path": "/v1/billing/subscription",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/Empty"
      },
      "response": { "$ref": "#/schemas/Subscription" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS",
        "BILLING.SUBSCRIPTION.NOT_FOUND"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:read"] },
      "description": "Gets the tenant subscription with its plan."
    },
    {
      "name": "getUsage",
      "id": "billing.usage.get",
      "method": "GET",
      "path": "/v1/billing/usage",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/Empty"
      },
      "response": { "$ref": "#/schemas/UsageOverview" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS",
        "BILLING.SUBSCRIPTION.NOT_FOUND"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:read"] },
      "description": "Gets the current period usage of each metric with a quota."
    },
    {
      "name": "listPlans",
      "id": "billing.plan.list",
      "method": "GET",
      "path": "/v1/billing/plans",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/Empty"
      },
      "response": { "$ref": "#/schemas/PlanCatalog" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:read"] },
      "description": "Lists the catalog plans with their price and limits."
    },
    {
      "name": "changePlan",
      "id": "billing.subscription.change-plan",
      "method": "PUT",
      "path": "/v1/billing/subscription/plan",
      "version": 1,
      "pathParams": [],
      "requestLocation": "body",
      "queryParams": [],
      "request": { "$ref": "#/schemas/ChangePlanRequest" },
      "response": { "$ref": "#/schemas/Subscription" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS",
        "PLATFORM.VALIDATION.INVALID_INPUT",
        "BILLING.SUBSCRIPTION.NOT_FOUND",
        "BILLING.SUBSCRIPTION.NOT_CHANGEABLE",
        "BILLING.PLAN.NOT_AVAILABLE",
        "BILLING.PLAN.USAGE_EXCEEDS_LIMIT"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:write"] },
      "description": "Changes the plan of the tenant subscription."
    },
    {
      "name": "listInvoices",
      "id": "billing.invoice.list",
      "method": "GET",
      "path": "/v1/billing/invoices",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [
        { "name": "status", "kind": "string", "list": false },
        { "name": "limit", "kind": "number", "list": false },
        { "name": "after", "kind": "string", "list": false }
      ],
      "request": { "$ref": "#/schemas/ListInvoicesRequest" },
      "response": { "$ref": "#/schemas/InvoicePage" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS",
        "PLATFORM.VALIDATION.INVALID_INPUT"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:read"] },
      "description": "Lists the tenant invoices, with filter and pagination."
    },
    {
      "name": "getInvoice",
      "id": "billing.invoice.get",
      "method": "GET",
      "path": "/v1/billing/invoices/{invoiceId}",
      "version": 1,
      "pathParams": ["invoiceId"],
      "requestLocation": "query",
      "queryParams": [],
      "request": { "$ref": "#/schemas/GetInvoiceRequest" },
      "response": { "$ref": "#/schemas/Invoice" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.SESSION.EXPIRED",
        "IDENTITY.TOKEN.REVOKED",
        "IDENTITY.USER.SUSPENDED",
        "IDENTITY.TENANT.SUSPENDED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS",
        "BILLING.INVOICE.NOT_FOUND"
      ],
      "access": { "kind": "authenticated", "permissions": ["billing:read"] },
      "description": "Gets an invoice with its lines."
    }
  ],
  "operations": [
    {
      "name": "openAccount",
      "id": "billing.accounts.open.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/OpenBillingAccountInput" },
      "output": { "$ref": "#/schemas/BillingAccountResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.accounts.close.v1",
      "errors": ["BILLING.PLAN.NOT_AVAILABLE"],
      "timeoutMs": 5000,
      "description": "Opens the billing account of a tenant with its subscription."
    },
    {
      "name": "closeAccount",
      "id": "billing.accounts.close.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/CloseBillingAccountInput" },
      "output": { "$ref": "#/schemas/BillingAccountClosed" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Only runs as compensation of the opening: with no invoice issued it deletes the subscription and there is nothing to restore.",
      "errors": ["BILLING.INVOICE.INVALID_STATE"],
      "timeoutMs": 5000,
      "description": "Closes the billing account of a tenant."
    },
    {
      "name": "getEntitlements",
      "id": "billing.entitlements.get.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/GetEntitlementsInput" },
      "output": { "$ref": "#/schemas/Entitlements" },
      "idempotent": true,
      "mutating": false,
      "errors": ["BILLING.SUBSCRIPTION.NOT_FOUND"],
      "timeoutMs": 5000,
      "description": "Gets the active features and quotas of a tenant."
    },
    {
      "name": "checkQuota",
      "id": "billing.quotas.check.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/CheckQuotaInput" },
      "output": { "$ref": "#/schemas/QuotaCheck" },
      "idempotent": true,
      "mutating": false,
      "errors": ["BILLING.SUBSCRIPTION.NOT_FOUND"],
      "timeoutMs": 1000,
      "description": "Checks whether a tenant can consume an amount of a metric."
    },
    {
      "name": "markInvoicePaid",
      "id": "billing.invoices.mark-paid.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/MarkInvoicePaidInput" },
      "output": { "$ref": "#/schemas/InvoiceStateResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "The payment happened outside billing; a mistake is fixed with a note, not with a reversal.",
      "errors": [
        "BILLING.INVOICE.NOT_FOUND",
        "BILLING.INVOICE.INVALID_STATE",
        "BILLING.INVOICE.AMOUNT_MISMATCH"
      ],
      "timeoutMs": 5000,
      "description": "Marks an invoice as paid with the provider reference and the amount charged, which must be its total."
    },
    {
      "name": "markInvoiceFailed",
      "id": "billing.invoices.mark-failed.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/MarkInvoiceFailedInput" },
      "output": { "$ref": "#/schemas/InvoiceStateResult" },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "The charge failed outside billing; a mistake is fixed with a note, not with a reversal.",
      "errors": ["BILLING.INVOICE.NOT_FOUND", "BILLING.INVOICE.INVALID_STATE"],
      "timeoutMs": 5000,
      "description": "Marks an invoice as failed after a declined charge."
    },
    {
      "name": "listInvoiceChanges",
      "id": "billing.invoices.list-changes.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/ListInvoiceChangesInput" },
      "output": { "$ref": "#/schemas/InvoiceChangePage" },
      "idempotent": true,
      "mutating": false,
      "errors": [],
      "timeoutMs": 5000,
      "description": "Pages the invoices of a tenant with their issue and payment dates."
    },
    {
      "name": "tenantMoveSync",
      "id": "billing.tenant-move.sync.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveProgress"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.tenant-move.abort.v1",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Copies a batch of the tenant data in billing to the target while writes continue; the saga repeats until the round completes."
    },
    {
      "name": "tenantMoveFinalize",
      "id": "billing.tenant-move.finalize.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveVerification"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.tenant-move.abort.v1",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Copies the last round of billing with the tenant frozen and verifies counts and sums."
    },
    {
      "name": "tenantMoveAbort",
      "id": "billing.tenant-move.abort.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Only runs as compensation of the copy: discards what was copied to the target and there is nothing to restore.",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Cancels the move of a tenant and discards what was copied from billing to the target."
    },
    {
      "name": "tenantMoveSwitch",
      "id": "billing.tenant-move.switch.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Runs after the pivot: the tenant already lives in the target and it is retried until completed.",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Points billing to the target of the moved tenant and reopens its writes."
    },
    {
      "name": "tenantMoveCleanup",
      "id": "billing.tenant-move.cleanup.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantMoveAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Deletes from the source the data already moved once the grace period expires: it is not restored.",
      "errors": [],
      "timeoutMs": 6000,
      "description": "Deletes from billing the data of the moved tenant when the grace period ends."
    },
    {
      "name": "tenantDirectoryPlace",
      "id": "billing.tenant-directory.place.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantDirectoryEntry"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantDirectoryAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "billing.tenant-directory.remove.v1",
      "errors": [],
      "timeoutMs": 5000,
      "description": "Records a new tenant in the billing shard directory with the region and groups identity chose; if it is already there, leaves it as is."
    },
    {
      "name": "tenantDirectoryRemove",
      "id": "billing.tenant-directory.remove.v1",
      "version": 1,
      "input": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantDirectoryRef"
      },
      "output": {
        "$ref": "../../platform/export/contract.json#/schemas/TenantDirectoryAck"
      },
      "idempotent": true,
      "mutating": true,
      "compensatedBy": "none",
      "compensationReason": "Only runs as compensation of the creation, before the tenant has data: there is nothing to restore.",
      "errors": [],
      "timeoutMs": 5000,
      "description": "Removes from billing the directory row of a tenant whose creation is undone."
    }
  ],
  "events": [
    {
      "name": "subscriptionChanged",
      "type": "billing.subscription.changed.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/SubscriptionChangedPayload" },
      "description": "The plan of a tenant subscription changed."
    },
    {
      "name": "subscriptionSuspended",
      "type": "billing.subscription.suspended.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/SubscriptionSuspendedPayload" },
      "description": "A tenant subscription was suspended. Identity suspends access."
    },
    {
      "name": "subscriptionReactivated",
      "type": "billing.subscription.reactivated.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/SubscriptionReactivatedPayload" },
      "description": "A tenant subscription was reactivated."
    },
    {
      "name": "entitlementsChanged",
      "type": "billing.entitlements.changed.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/EntitlementsChangedPayload" },
      "description": "The active features and quotas of a tenant changed. Identity reflects them in the permissions."
    },
    {
      "name": "invoiceIssued",
      "type": "billing.invoice.issued.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/InvoiceIssuedPayload" },
      "description": "An invoice was issued."
    },
    {
      "name": "invoicePaid",
      "type": "billing.invoice.paid.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/InvoicePaidPayload" },
      "description": "An invoice was paid."
    },
    {
      "name": "invoiceFailed",
      "type": "billing.invoice.failed.v1",
      "kind": "event",
      "version": 1,
      "payload": { "$ref": "#/schemas/InvoiceFailedPayload" },
      "description": "Charging an invoice failed."
    }
  ],
  "commands": [
    {
      "name": "recordUsage",
      "type": "billing.usage.record.v1",
      "kind": "command",
      "version": 1,
      "payload": { "$ref": "#/schemas/RecordUsagePayload" },
      "description": "Records the usage of a tenant metered by another service. Each record carries its idempotency key."
    }
  ],
  "errors": {
    "BillingErrorCode": [
      {
        "name": "SubscriptionNotFound",
        "code": "BILLING.SUBSCRIPTION.NOT_FOUND",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_subscription_not_found",
        "description": "The tenant has no subscription."
      },
      {
        "name": "SubscriptionNotChangeable",
        "code": "BILLING.SUBSCRIPTION.NOT_CHANGEABLE",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_subscription_not_changeable",
        "description": "The subscription is suspended or cancelled and does not allow a plan change."
      },
      {
        "name": "PlanNotAvailable",
        "code": "BILLING.PLAN.NOT_AVAILABLE",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_plan_not_available",
        "description": "The plan does not exist or is not available for this tenant."
      },
      {
        "name": "PlanUsageExceedsLimit",
        "code": "BILLING.PLAN.USAGE_EXCEEDS_LIMIT",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_plan_usage_exceeds_limit",
        "description": "Current usage exceeds a limit of the new plan: cannot downgrade to that plan."
      },
      {
        "name": "InvoiceNotFound",
        "code": "BILLING.INVOICE.NOT_FOUND",
        "httpStatus": 404,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_invoice_not_found",
        "description": "The invoice does not exist in the tenant."
      },
      {
        "name": "InvoiceInvalidState",
        "code": "BILLING.INVOICE.INVALID_STATE",
        "httpStatus": 409,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_invoice_invalid_state",
        "description": "The invoice is not in a state that allows the requested operation."
      },
      {
        "name": "InvoiceAmountMismatch",
        "code": "BILLING.INVOICE.AMOUNT_MISMATCH",
        "httpStatus": 422,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_invoice_amount_mismatch",
        "description": "The amount paid does not match the invoice total in its currency. The details carry expected and received."
      },
      {
        "name": "QuotaExceeded",
        "code": "BILLING.QUOTA.EXCEEDED",
        "httpStatus": 403,
        "retryable": false,
        "audience": "public",
        "messageKey": "error_billing_quota_exceeded",
        "description": "The plan quota was reached. The details carry metric, limit and used."
      }
    ]
  }
}
