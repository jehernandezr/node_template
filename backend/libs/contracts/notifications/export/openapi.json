{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "notifications",
    "version": "2",
    "description": "Notifications: user inbox, preferences, per-channel dispatch, transactional email and realtime."
  },
  "paths": {
    "/v1/notifications": {
      "get": {
        "operationId": "notifications.inbox.list",
        "description": "Lists the notifications in the user inbox.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationPage" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      }
    },
    "/v1/notifications/unread-count": {
      "get": {
        "operationId": "notifications.inbox.unread-count",
        "description": "Counts the unread notifications in the user inbox.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnreadCount" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      }
    },
    "/v1/notifications/{notificationId}/read": {
      "post": {
        "operationId": "notifications.inbox.mark-read",
        "description": "Marks a notification as read; repeating it does not fail.",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "No content." },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, NOTIFICATIONS.INBOX.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "NOTIFICATIONS.INBOX.NOT_FOUND"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkNotificationReadRequest"
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      }
    },
    "/v1/notifications/read-all": {
      "post": {
        "operationId": "notifications.inbox.mark-all-read",
        "description": "Marks all notifications of the user as read.",
        "parameters": [],
        "responses": {
          "204": { "description": "No content." },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Empty"
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      }
    },
    "/v1/notification-preferences": {
      "get": {
        "operationId": "notifications.preferences.get",
        "description": "Returns the notification preferences of the user.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPreferences"
                }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      },
      "put": {
        "operationId": "notifications.preferences.save",
        "description": "Saves the notification preferences of the user.",
        "parameters": [],
        "responses": {
          "204": { "description": "No content." },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.VALIDATION.INVALID_INPUT, NOTIFICATIONS.PREFERENCES.INVALID_QUIET_HOURS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.VALIDATION.INVALID_INPUT",
          "NOTIFICATIONS.PREFERENCES.INVALID_QUIET_HOURS"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPreferences"
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": []
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationType": {
        "type": "string",
        "enum": [
          "security_alert",
          "task_updated",
          "invoice_issued",
          "account_activity"
        ],
        "description": "Notification type."
      },
      "NotificationChannel": {
        "type": "string",
        "enum": ["in_app", "push", "email"],
        "description": "Channel of a notification."
      },
      "NotificationCreatedPayload": {
        "type": "object",
        "properties": {
          "notificationId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/NotificationType" },
          "channels": {
            "maxItems": 3,
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationChannel" }
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "notificationId",
          "tenantId",
          "type",
          "channels",
          "createdAt"
        ],
        "description": "A notification was created."
      },
      "AppNotification": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/NotificationType" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "read": { "type": "boolean" }
        },
        "required": ["id", "type", "title", "body", "createdAt", "read"],
        "description": "Notification in the user inbox."
      },
      "NotificationPage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/AppNotification" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of the inbox, newest to oldest."
      },
      "UnreadCount": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["count"],
        "description": "Unread notifications in the inbox."
      },
      "MarkNotificationReadRequest": {
        "type": "object",
        "properties": {
          "notificationId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["notificationId"],
        "additionalProperties": false,
        "description": "Notification to mark as read."
      },
      "NotificationPreferenceEntry": {
        "type": "object",
        "properties": {
          "type": { "$ref": "#/components/schemas/NotificationType" },
          "channels": {
            "maxItems": 3,
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationChannel" }
          }
        },
        "required": ["type", "channels"],
        "description": "Channels through which the user receives a notification type."
      },
      "NotificationPreferences": {
        "type": "object",
        "properties": {
          "enabled": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationPreferenceEntry"
            }
          },
          "quietStart": {
            "type": "string",
            "minLength": 5,
            "maxLength": 5,
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "quietEnd": {
            "type": "string",
            "minLength": 5,
            "maxLength": 5,
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "required": ["enabled", "quietStart", "quietEnd", "timezone"],
        "additionalProperties": false,
        "description": "Notification preferences of the user."
      },
      "EmailTemplate": {
        "type": "string",
        "enum": [
          "verify_email",
          "password_reset",
          "mfa_code",
          "email_change",
          "invitation",
          "email_already_registered",
          "mfa_recovery"
        ],
        "description": "Transactional email template."
      },
      "TemplateParameter": {
        "type": "string",
        "enum": [
          "code",
          "link",
          "display_name",
          "tenant_name",
          "reference",
          "available_at"
        ],
        "description": "Name of a value that fills a template."
      },
      "TemplateParameterValue": {
        "type": "object",
        "properties": {
          "name": { "$ref": "#/components/schemas/TemplateParameter" },
          "value": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "required": ["name", "value"],
        "additionalProperties": false,
        "description": "Value of a template field."
      },
      "SendEmailInput": {
        "type": "object",
        "properties": {
          "messageId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "template": { "$ref": "#/components/schemas/EmailTemplate" },
          "to": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
          "parameters": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TemplateParameterValue" }
          }
        },
        "required": ["messageId", "template", "to", "parameters"],
        "additionalProperties": false,
        "description": "Transactional email to send, with its template values."
      },
      "SendEmailResult": {
        "type": "object",
        "properties": {
          "messageId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["messageId"],
        "description": "Transactional email accepted for sending."
      },
      "NotifyUserInput": {
        "type": "object",
        "properties": {
          "notificationId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "user": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/NotificationType" },
          "parameters": {
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TemplateParameterValue" }
          }
        },
        "required": [
          "notificationId",
          "user",
          "tenantId",
          "type",
          "parameters"
        ],
        "additionalProperties": false,
        "description": "Notification to deliver to a user through their channels."
      },
      "NotifyUserResult": {
        "type": "object",
        "properties": {
          "notificationId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "channels": {
            "maxItems": 3,
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationChannel" }
          }
        },
        "required": ["notificationId", "channels"],
        "description": "Channels through which a notification was sent."
      },
      "EraseNotificationsUserInput": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          }
        },
        "required": ["user"],
        "additionalProperties": false,
        "description": "User whose notification data is deleted."
      },
      "EraseNotificationsUserResult": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "affectedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["userId", "affectedRows"],
        "description": "Notification rows deleted for a user."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
