          "$ref": "#/components/messages/identity.tenant.suspended.v1"
        },
        "identity.tenant.reactivated.v1": {
          "$ref": "#/components/messages/identity.tenant.reactivated.v1"
        },
        "identity.membership.changed.v1": {
          "$ref": "#/components/messages/identity.membership.changed.v1"
        },
        "identity.permissions.changed.v1": {
          "$ref": "#/components/messages/identity.permissions.changed.v1"
        },
        "identity.api-key.created.v1": {
          "$ref": "#/components/messages/identity.api-key.created.v1"
        },
        "identity.api-key.revoked.v1": {
          "$ref": "#/components/messages/identity.api-key.revoked.v1"
        },
        "identity.security-alert.raised.v1": {
          "$ref": "#/components/messages/identity.security-alert.raised.v1"
        }
      }
    },
