{
  "$comment": "GENERADO por backend/tools/contracts-export desde los contratos. No editar: ejecuta pnpm nx run contracts-export:export.",
  "asyncapi": "3.0.0",
  "info": {
    "title": "Mensajería de la plataforma",
    "version": "1.0.0",
    "description": "Eventos y comandos entre servicios. Cada mensaje viaja en un sobre CloudEvents 1.0; el payload descrito aquí es el campo data. Los tópicos son SNS y las colas SQS."
  },
  "defaultContentType": "application/json",
