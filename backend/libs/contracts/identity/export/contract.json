{
  "$comment": "GENERADO por backend/tools/contracts-export. No editar: cambia el contrato en TypeScript y ejecuta pnpm nx run contracts-export:export.",
  "formatVersion": 2,
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "service": "identity",
  "description": "Identidad: inicio de sesión, MFA, sesiones, dispositivos y enums de acceso.",
  "enums": {
    "Permission": {
      "values": [
        { "name": "TasksRead", "value": "tasks:read" },
        { "name": "TasksWrite", "value": "tasks:write" },
        { "name": "BillingRead", "value": "billing:read" },
        { "name": "BillingWrite", "value": "billing:write" },
        { "name": "BackofficeAccess", "value": "backoffice:access" }
      ]
    },
    "PlatformRole": {
      "values": [
        { "name": "SuperAdmin", "value": "super_admin" },
        { "name": "Support", "value": "support" },
        { "name": "Finance", "value": "finance" },
        { "name": "ReadOnly", "value": "read_only" }
      ]
    },
    "PlanFeature": {
      "values": [
        { "name": "AiAssistant", "value": "ai_assistant" },
        { "name": "Webhooks", "value": "webhooks" },
        { "name": "Billing", "value": "billing" }
      ]
    },
    "FeatureFlag": {
      "values": [{ "name": "NewReports", "value": "new_reports" }]
    },
    "MfaFactor": {
      "values": [
        { "name": "DeviceOtp", "value": "device_otp" },
        { "name": "EmailOtp", "value": "email_otp" },
        { "name": "Totp", "value": "totp" },
        { "name": "RecoveryCode", "value": "recovery_code" },
        { "name": "Passkey", "value": "passkey" }
      ]
    },
    "SignInStatus": {
      "values": [
        { "name": "Authenticated", "value": "authenticated" },
        { "name": "MfaRequired", "value": "mfa_required" }
      ]
    },
    "ClientPlatform": {
      "values": [
        { "name": "Ios", "value": "ios" },
        { "name": "Android", "value": "android" },
        { "name": "Web", "value": "web" },
        { "name": "Macos", "value": "macos" },
        { "name": "Windows", "value": "windows" },
        { "name": "Linux", "value": "linux" }
      ]
    },
    "RevocationReason": {
      "values": [
        { "name": "Logout", "value": "logout" },
        { "name": "UserAction", "value": "user_action" },
        { "name": "PasswordChanged", "value": "password_changed" },
        { "name": "AdminAction", "value": "admin_action" },
        { "name": "Compromised", "value": "compromised" }
      ]
    },
    "RevocationScope": {
      "values": [
        { "name": "Session", "value": "session" },
        { "name": "User", "value": "user" },
        { "name": "Tenant", "value": "tenant" }
      ]
    },
    "IdentityErrorCode": {
      "values": [
        {
          "name": "AuthInvalidCredentials",
          "value": "IDENTITY.AUTH.INVALID_CREDENTIALS"
        },
        { "name": "MfaTokenInvalid", "value": "IDENTITY.MFA.TOKEN_INVALID" },
        { "name": "MfaCodeInvalid", "value": "IDENTITY.MFA.CODE_INVALID" },
        { "name": "MfaCodeExpired", "value": "IDENTITY.MFA.CODE_EXPIRED" },
        {
          "name": "MfaTooManyAttempts",
          "value": "IDENTITY.MFA.TOO_MANY_ATTEMPTS"
        },
        {
          "name": "MfaStepUpRequired",
          "value": "IDENTITY.MFA.STEP_UP_REQUIRED"
        },
        { "name": "SessionRevoked", "value": "IDENTITY.SESSION.REVOKED" },
        {
          "name": "TokenStalePermissions",
          "value": "IDENTITY.TOKEN.STALE_PERMISSIONS"
        },
        { "name": "UserNotFound", "value": "IDENTITY.USER.NOT_FOUND" }
      ]
    },
    "IdentityRoute": {
      "values": [
        { "name": "SignIn", "value": "identity.auth.sign-in" },
        {
          "name": "RequestMfaChallenge",
          "value": "identity.auth.mfa-challenge"
        },
        { "name": "VerifyMfa", "value": "identity.auth.mfa-verify" },
        { "name": "GetSessionAccess", "value": "identity.me.access" },
        { "name": "ListSessions", "value": "identity.sessions.list" },
        { "name": "RevokeSession", "value": "identity.sessions.revoke" },
        {
          "name": "RevokeOtherSessions",
          "value": "identity.sessions.revoke-others"
        },
        { "name": "ListDevices", "value": "identity.devices.list" }
      ]
    },
    "IdentityOperation": {
      "values": [
        {
          "name": "RevokeUserSessions",
          "value": "identity.sessions.revoke-for-user.v1"
        },
        { "name": "GetUserAccess", "value": "identity.users.get-access.v1" }
      ]
    },
    "IdentityEvent": {
      "values": [
        { "name": "SessionRevoked", "value": "identity.session.revoked.v1" },
        { "name": "TokensRevoked", "value": "identity.tokens.revoked.v1" }
      ]
    },
    "IdentityTopic": {
      "values": [{ "name": "Events", "value": "identity-events" }]
    }
  },
  "constants": {
    "IdentityLimits": {
      "emailMaxLength": 254,
      "passwordMaxLength": 128,
      "deviceIdMaxLength": 512,
      "deviceNameMaxLength": 120,
      "devicePublicKeyMaxLength": 2048,
      "mfaTokenMaxLength": 2048,
      "mfaCodeMinLength": 6,
      "mfaCodeMaxLength": 64,
      "tokenMaxLength": 8192
    },
    "MfaRules": {
      "deviceCodeLength": 8,
      "emailCodeLength": 6,
      "maxAttemptsPerChallenge": 5,
      "maxChallengesPerWindow": 3,
      "challengeWindowMinutes": 15,
      "deviceCodeTtlSeconds": 180,
      "emailCodeTtlSeconds": 300,
      "stepUpMaxAgeMinutes": 10
    }
  },
  "schemas": {
    "Permission": {
      "type": "string",
      "enum": [
        "tasks:read",
        "tasks:write",
        "billing:read",
        "billing:write",
        "backoffice:access"
      ],
      "description": "Permiso dentro de un tenant."
    },
    "PlatformRole": {
      "type": "string",
      "enum": ["super_admin", "support", "finance", "read_only"],
      "description": "Rol de plataforma."
    },
    "PlanFeature": {
      "type": "string",
      "enum": ["ai_assistant", "webhooks", "billing"],
      "description": "Funcionalidad del plan."
    },
    "FeatureFlag": {
      "type": "string",
      "enum": ["new_reports"],
      "description": "Feature flag."
    },
    "MfaFactor": {
      "type": "string",
      "enum": ["device_otp", "email_otp", "totp", "recovery_code", "passkey"],
      "description": "Método de segundo factor."
    },
    "SignInStatus": {
      "type": "string",
      "enum": ["authenticated", "mfa_required"],
      "description": "Resultado de un inicio de sesión."
    },
    "ClientPlatform": {
      "type": "string",
      "enum": ["ios", "android", "web", "macos", "windows", "linux"],
      "description": "Plataforma del cliente."
    },
    "RevocationReason": {
      "type": "string",
      "enum": [
        "logout",
        "user_action",
        "password_changed",
        "admin_action",
        "compromised"
      ],
      "description": "Motivo de una revocación."
    },
    "RevocationScope": {
      "type": "string",
      "enum": ["session", "user", "tenant"],
      "description": "Alcance de una revocación de tokens."
    },
    "SignInRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "password": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["email", "password"],
      "additionalProperties": false,
      "description": "Inicio de sesión con email y contraseña."
    },
    "SessionTokens": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "accessExpiresAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "sessionToken": { "type": "string", "minLength": 1, "maxLength": 8192 }
      },
      "required": ["accessToken", "accessExpiresAt"],
      "description": "Tokens de una sesión."
    },
    "PendingMfa": {
      "type": "object",
      "properties": {
        "mfaToken": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "methods": {
          "minItems": 1,
          "type": "array",
          "items": { "$ref": "#/schemas/MfaFactor" }
        }
      },
      "required": ["mfaToken", "methods"],
      "description": "Desafío MFA pendiente."
    },
    "SignInResponse": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/schemas/SignInStatus" },
        "tokens": { "$ref": "#/schemas/SessionTokens" },
        "mfa": { "$ref": "#/schemas/PendingMfa" }
      },
      "required": ["status"],
      "description": "Resultado de un login o de una verificación MFA."
    },
    "MfaChallengeRequest": {
      "type": "object",
      "properties": {
        "mfaToken": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "method": { "$ref": "#/schemas/MfaFactor" }
      },
      "required": ["mfaToken", "method"],
      "additionalProperties": false,
      "description": "Pedido de un desafío MFA."
    },
    "MfaChallenge": {
      "type": "object",
      "properties": {
        "challengeId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "method": { "$ref": "#/schemas/MfaFactor" },
        "expiresAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "codeLength": { "type": "integer", "minimum": 6, "maximum": 64 }
      },
      "required": ["challengeId", "method", "expiresAt"],
      "description": "Desafío MFA creado."
    },
    "MfaVerifyRequest": {
      "type": "object",
      "properties": {
        "mfaToken": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "challengeId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "devicePublicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": ["mfaToken", "challengeId", "code"],
      "additionalProperties": false,
      "description": "Verificación de un desafío MFA."
    },
    "SessionSummary": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "platform": { "$ref": "#/schemas/ClientPlatform" },
        "lastSeenAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "current": { "type": "boolean" }
      },
      "required": ["id", "deviceName", "platform", "lastSeenAt", "current"],
      "description": "Sesión activa en un dispositivo."
    },
    "SessionPage": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/schemas/SessionSummary" }
        },
        "nextCursor": {
          "anyOf": [
            { "$ref": "../../platform/export/contract.json#/schemas/Cursor" },
            { "type": "null" }
          ]
        }
      },
      "required": ["items", "nextCursor"],
      "description": "Página de sesiones."
    },
    "DeviceSummary": {
      "type": "object",
      "properties": {
        "id": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "platform": { "$ref": "#/schemas/ClientPlatform" },
        "lastSeenAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "trustedUntil": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        },
        "verifier": { "type": "boolean" }
      },
      "required": ["id", "name", "platform", "lastSeenAt", "verifier"],
      "description": "Dispositivo con confianza vigente."
    },
    "DevicePage": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": { "$ref": "#/schemas/DeviceSummary" }
        },
        "nextCursor": {
          "anyOf": [
            { "$ref": "../../platform/export/contract.json#/schemas/Cursor" },
            { "type": "null" }
          ]
        }
      },
      "required": ["items", "nextCursor"],
      "description": "Página de dispositivos."
    },
    "RevokeSessionRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["sessionId"],
      "additionalProperties": false,
      "description": "Sesión a cerrar."
    },
    "RevokedSessions": {
      "type": "object",
      "properties": {
        "revoked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["revoked"],
      "description": "Cantidad de sesiones cerradas."
    },
    "RevokeUserSessionsInput": {
      "type": "object",
      "properties": {
        "userId": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "reason": { "$ref": "#/schemas/RevocationReason" }
      },
      "required": ["userId", "reason"],
      "additionalProperties": false,
      "description": "Revoca todas las sesiones de un usuario."
    },
    "GetUserAccessInput": {
      "type": "object",
      "properties": {
        "userId": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        }
      },
      "required": ["userId", "tenantId"],
      "additionalProperties": false,
      "description": "Usuario y tenant a consultar."
    },
    "UserAccess": {
      "type": "object",
      "properties": {
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/schemas/Permission" }
        },
        "platformRoles": {
          "type": "array",
          "items": { "$ref": "#/schemas/PlatformRole" }
        },
        "features": {
          "type": "array",
          "items": { "$ref": "#/schemas/PlanFeature" }
        },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/schemas/FeatureFlag" }
        }
      },
      "required": ["permissions", "platformRoles", "features", "flags"],
      "description": "Acceso efectivo de un usuario en un tenant."
    },
    "SessionAccess": {
      "type": "object",
      "properties": {
        "userId": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "sessionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/schemas/Permission" }
        },
        "platformRoles": {
          "type": "array",
          "items": { "$ref": "#/schemas/PlatformRole" }
        },
        "features": {
          "type": "array",
          "items": { "$ref": "#/schemas/PlanFeature" }
        },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/schemas/FeatureFlag" }
        },
        "mfaVerifiedAt": {
          "anyOf": [
            {
              "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
            },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "userId",
        "tenantId",
        "sessionId",
        "permissions",
        "platformRoles",
        "features",
        "flags",
        "mfaVerifiedAt"
      ],
      "description": "Acceso de la sesión actual: usuario, tenant, permisos, roles, plan, flags y último MFA."
    },
    "SessionRevokedPayload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "userId": { "$ref": "../../platform/export/contract.json#/schemas/Id" },
        "tenantId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "reason": { "$ref": "#/schemas/RevocationReason" },
        "revokedAt": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["sessionId", "userId", "tenantId", "reason", "revokedAt"],
      "description": "Se revocó una sesión."
    },
    "TokensRevokedPayload": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/schemas/RevocationScope" },
        "subjectId": {
          "$ref": "../../platform/export/contract.json#/schemas/Id"
        },
        "revokedBefore": {
          "$ref": "../../platform/export/contract.json#/schemas/Timestamp"
        }
      },
      "required": ["scope", "subjectId", "revokedBefore"],
      "description": "Se revocaron tokens de una sesión, un usuario o un tenant."
    }
  },
  "routes": [
    {
      "name": "signIn",
      "id": "identity.auth.sign-in",
      "method": "POST",
      "path": "/v1/auth/sign-in",
      "version": 1,
      "pathParams": [],
      "requestLocation": "body",
      "queryParams": [],
      "request": { "$ref": "#/schemas/SignInRequest" },
      "response": { "$ref": "#/schemas/SignInResponse" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.AUTH.INVALID_CREDENTIALS",
        "PLATFORM.RATE_LIMIT.EXCEEDED"
      ],
      "access": { "kind": "public" },
      "description": "Inicia sesión con email y contraseña. Responde tokens o un desafío MFA."
    },
    {
      "name": "requestMfaChallenge",
      "id": "identity.auth.mfa-challenge",
      "method": "POST",
      "path": "/v1/auth/mfa/challenges",
      "version": 1,
      "pathParams": [],
      "requestLocation": "body",
      "queryParams": [],
      "request": { "$ref": "#/schemas/MfaChallengeRequest" },
      "response": { "$ref": "#/schemas/MfaChallenge" },
      "successStatus": 201,
      "errors": [
        "IDENTITY.MFA.TOKEN_INVALID",
        "IDENTITY.MFA.TOO_MANY_ATTEMPTS",
        "PLATFORM.RATE_LIMIT.EXCEEDED"
      ],
      "access": { "kind": "public" },
      "description": "Crea un desafío MFA para el login pendiente y envía el código por el método elegido."
    },
    {
      "name": "verifyMfa",
      "id": "identity.auth.mfa-verify",
      "method": "POST",
      "path": "/v1/auth/mfa/verify",
      "version": 1,
      "pathParams": [],
      "requestLocation": "body",
      "queryParams": [],
      "request": { "$ref": "#/schemas/MfaVerifyRequest" },
      "response": { "$ref": "#/schemas/SignInResponse" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.MFA.TOKEN_INVALID",
        "IDENTITY.MFA.CODE_INVALID",
        "IDENTITY.MFA.CODE_EXPIRED",
        "IDENTITY.MFA.TOO_MANY_ATTEMPTS",
        "PLATFORM.RATE_LIMIT.EXCEEDED"
      ],
      "access": { "kind": "public" },
      "description": "Verifica un desafío MFA, crea la sesión y registra el dispositivo nuevo."
    },
    {
      "name": "getSessionAccess",
      "id": "identity.me.access",
      "method": "GET",
      "path": "/v1/me/access",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/Empty"
      },
      "response": { "$ref": "#/schemas/SessionAccess" },
      "successStatus": 200,
      "errors": [
        "IDENTITY.SESSION.REVOKED",
        "IDENTITY.TOKEN.STALE_PERMISSIONS"
      ],
      "access": { "kind": "authenticated" },
      "description": "Devuelve usuario, tenant, permisos, roles, plan, flags y último MFA de la sesión actual."
    },
    {
      "name": "listSessions",
      "id": "identity.sessions.list",
      "method": "GET",
      "path": "/v1/me/sessions",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [
        { "name": "limit", "kind": "number", "list": false },
        { "name": "after", "kind": "string", "list": false }
      ],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/PageQuery"
      },
      "response": { "$ref": "#/schemas/SessionPage" },
      "successStatus": 200,
      "errors": ["IDENTITY.SESSION.REVOKED"],
      "access": { "kind": "authenticated" },
      "description": "Lista las sesiones activas del usuario, la actual primero."
    },
    {
      "name": "revokeSession",
      "id": "identity.sessions.revoke",
      "method": "DELETE",
      "path": "/v1/me/sessions/{sessionId}",
      "version": 1,
      "pathParams": ["sessionId"],
      "requestLocation": "query",
      "queryParams": [],
      "request": { "$ref": "#/schemas/RevokeSessionRequest" },
      "response": null,
      "successStatus": 204,
      "errors": ["PLATFORM.RESOURCE.NOT_FOUND", "IDENTITY.SESSION.REVOKED"],
      "access": { "kind": "authenticated" },
      "description": "Cierra una sesión del usuario y revoca sus tokens."
    },
    {
      "name": "revokeOtherSessions",
      "id": "identity.sessions.revoke-others",
      "method": "POST",
      "path": "/v1/me/sessions/revoke-others",
      "version": 1,
      "pathParams": [],
      "requestLocation": "body",
      "queryParams": [],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/Empty"
      },
      "response": { "$ref": "#/schemas/RevokedSessions" },
      "successStatus": 200,
      "errors": ["IDENTITY.SESSION.REVOKED"],
      "access": { "kind": "authenticated" },
      "description": "Cierra todas las sesiones del usuario menos la actual."
    },
    {
      "name": "listDevices",
      "id": "identity.devices.list",
      "method": "GET",
      "path": "/v1/me/devices",
      "version": 1,
      "pathParams": [],
      "requestLocation": "query",
      "queryParams": [
        { "name": "limit", "kind": "number", "list": false },
        { "name": "after", "kind": "string", "list": false }
      ],
      "request": {
        "$ref": "../../platform/export/contract.json#/schemas/PageQuery"
      },
      "response": { "$ref": "#/schemas/DevicePage" },
      "successStatus": 200,
      "errors": ["IDENTITY.SESSION.REVOKED"],
      "access": { "kind": "authenticated" },
      "description": "Lista los dispositivos del usuario con confianza vigente."
    }
  ],
  "operations": [
    {
      "name": "revokeUserSessions",
      "id": "identity.sessions.revoke-for-user.v1",
      "version": 1,
      "input": { "$ref": "#/schemas/RevokeUserSessionsInput" },
      "output": { "$ref": "#/schemas/RevokedSessions" },
      "idempotent": true,
