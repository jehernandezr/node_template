{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "tasks",
    "version": "2",
    "description": "Organization tasks: creation, reading, search, change and deletion, and the events other services consume."
  },
  "paths": {
    "/v1/tasks": {
      "get": {
        "operationId": "tasks.task.list",
        "description": "Lists the tasks of the active tenant or searches them by text.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskPage" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.QUOTA.EXCEEDED, PLATFORM.VALIDATION.INVALID_INPUT, TASKS.SEARCH.QUERY_TOO_SHORT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.QUOTA.EXCEEDED",
          "PLATFORM.VALIDATION.INVALID_INPUT",
          "TASKS.SEARCH.QUERY_TOO_SHORT"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["tasks:read"]
      },
      "post": {
        "operationId": "tasks.task.create",
        "description": "Creates a task in the active tenant.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.QUOTA.EXCEEDED, PLATFORM.VALIDATION.INVALID_INPUT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.QUOTA.EXCEEDED",
          "PLATFORM.VALIDATION.INVALID_INPUT"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["tasks:write"]
      }
    },
    "/v1/tasks/{taskId}": {
      "get": {
        "operationId": "tasks.task.get",
        "description": "Returns a task of the active tenant.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.QUOTA.EXCEEDED, TASKS.TASK.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.QUOTA.EXCEEDED",
          "TASKS.TASK.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["tasks:read"]
      },
      "patch": {
        "operationId": "tasks.task.update",
        "description": "Changes fields of a task. With expectedVersion, rejects the change if the task was modified before.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.QUOTA.EXCEEDED, PLATFORM.VALIDATION.INVALID_INPUT, TASKS.TASK.NOT_FOUND, TASKS.TASK.VERSION_CONFLICT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.QUOTA.EXCEEDED",
          "PLATFORM.VALIDATION.INVALID_INPUT",
          "TASKS.TASK.NOT_FOUND",
          "TASKS.TASK.VERSION_CONFLICT"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["tasks:write"]
      },
      "delete": {
        "operationId": "tasks.task.delete",
        "description": "Soft deletes a task.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "No content." },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, BILLING.QUOTA.EXCEEDED, TASKS.TASK.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "BILLING.QUOTA.EXCEEDED",
          "TASKS.TASK.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["tasks:write"]
      }
    }
  },
  "components": {
    "schemas": {
      "TaskStatus": {
        "type": "string",
        "enum": ["open", "in_progress", "done"],
        "description": "Status of a task."
      },
      "TaskField": {
        "type": "string",
        "enum": ["title", "description", "status"],
        "description": "Task field that a change can modify."
      },
      "TaskCreatedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "createdBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "taskId",
          "status",
          "version",
          "createdBy",
          "createdAt"
        ],
        "description": "A task was created."
      },
      "TaskUpdatedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "changedFields": {
            "maxItems": 3,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TaskField" }
          },
          "statusBefore": { "$ref": "#/components/schemas/TaskStatus" },
          "statusAfter": { "$ref": "#/components/schemas/TaskStatus" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "actor": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "createdBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "updatedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "taskId",
          "changedFields",
          "statusBefore",
          "statusAfter",
          "version",
          "actor",
          "createdBy",
          "updatedAt"
        ],
        "description": "A task was changed."
      },
      "TaskDeletedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "actor": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "deletedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "taskId",
          "status",
          "version",
          "actor",
          "deletedAt"
        ],
        "description": "A task was deleted."
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 5000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "updatedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "createdBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "status",
          "version",
          "createdAt",
          "updatedAt",
          "createdBy"
        ],
        "description": "A task of the organization."
      },
      "TaskPage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/Task" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of tenant tasks."
      },
      "ListTasksRequest": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "q": { "type": "string", "minLength": 1, "maxLength": 200 },
          "limit": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/PageLimit"
          },
          "after": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
          }
        },
        "additionalProperties": false,
        "description": "Listing or search of tasks, with an optional status filter."
      },
      "GetTaskRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["taskId"],
        "additionalProperties": false,
        "description": "Task to query."
      },
      "CreateTaskRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 5000 }
        },
        "required": ["title"],
        "additionalProperties": false,
        "description": "Task creation."
      },
      "UpdateTaskRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 5000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["taskId"],
        "additionalProperties": false,
        "description": "Partial changes of a task, with an optional expected version."
      },
      "DeleteTaskRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["taskId"],
        "additionalProperties": false,
        "description": "Task to delete."
      },
      "TaskChange": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 5000 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "updatedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "createdBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "deletedAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "status",
          "version",
          "createdAt",
          "updatedAt",
          "createdBy",
          "deletedAt"
        ],
        "description": "Task with the soft delete date, if any."
      },
      "TaskChangePage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/TaskChange" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of task changes."
      },
      "ListTaskChangesInput": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "updatedAfter": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "limit": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/PageLimit"
          },
          "after": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
          }
        },
        "required": ["tenantId"],
        "additionalProperties": false,
        "description": "Input to page the task changes of a tenant."
      },
      "EraseTasksUserInput": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          }
        },
        "required": ["user"],
        "additionalProperties": false,
        "description": "User whose data is anonymized in the tasks."
      },
      "EraseTasksUserResult": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "affectedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["userId", "affectedRows"],
        "description": "Task rows anonymized for a user."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
