{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "reports",
    "version": "2",
    "description": "Reports on tenant data: catalog, runs computed in the background and stored result."
  },
  "paths": {
    "/v1/reports": {
      "get": {
        "operationId": "reports.catalog.list",
        "description": "Lists the report types, with their formats and granularities.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportCatalog" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.ACCESS.FLAG_DISABLED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.ACCESS.FLAG_DISABLED"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["reports:read"]
      }
    },
    "/v1/reports/runs": {
      "post": {
        "operationId": "reports.run.create",
        "description": "Creates a report run. Responds 202 with its id.",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportRunCreated" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.ACCESS.FLAG_DISABLED, PLATFORM.VALIDATION.INVALID_INPUT, PLATFORM.ACCESS.FEATURE_NOT_INCLUDED, REPORTS.TYPE.UNKNOWN, REPORTS.PARAMS.INVALID_RANGE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.ACCESS.FLAG_DISABLED",
          "PLATFORM.VALIDATION.INVALID_INPUT",
          "PLATFORM.ACCESS.FEATURE_NOT_INCLUDED",
          "REPORTS.TYPE.UNKNOWN",
          "REPORTS.PARAMS.INVALID_RANGE"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReportRunRequest"
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["reports:write"]
      },
      "get": {
        "operationId": "reports.run.list",
        "description": "Lists the report runs, with filters and pagination.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportRunPage" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.ACCESS.FLAG_DISABLED, PLATFORM.VALIDATION.INVALID_INPUT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.ACCESS.FLAG_DISABLED",
          "PLATFORM.VALIDATION.INVALID_INPUT"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["reports:read"]
      }
    },
    "/v1/reports/runs/{runId}": {
      "get": {
        "operationId": "reports.run.get",
        "description": "Gets a report run and its result.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportRunDetail" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.ACCESS.FLAG_DISABLED, REPORTS.RUN.NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.ACCESS.FLAG_DISABLED",
          "REPORTS.RUN.NOT_FOUND"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["reports:read"]
      }
    },
    "/v1/reports/runs/{runId}/download": {
      "get": {
        "operationId": "reports.run.download",
        "description": "Downloads the result of a ready run in its format.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportDownload" }
              }
            }
          },
          "default": {
            "description": "Problem Details with one of these codes: IDENTITY.SESSION.REVOKED, IDENTITY.SESSION.EXPIRED, IDENTITY.TOKEN.REVOKED, IDENTITY.USER.SUSPENDED, IDENTITY.TENANT.SUSPENDED, IDENTITY.TOKEN.STALE_PERMISSIONS, PLATFORM.ACCESS.FLAG_DISABLED, REPORTS.RUN.NOT_FOUND, REPORTS.RUN.NOT_READY, REPORTS.RUN.EXPIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../platform/export/openapi.json#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-error-codes": [
          "IDENTITY.SESSION.REVOKED",
          "IDENTITY.SESSION.EXPIRED",
          "IDENTITY.TOKEN.REVOKED",
          "IDENTITY.USER.SUSPENDED",
          "IDENTITY.TENANT.SUSPENDED",
          "IDENTITY.TOKEN.STALE_PERMISSIONS",
          "PLATFORM.ACCESS.FLAG_DISABLED",
          "REPORTS.RUN.NOT_FOUND",
          "REPORTS.RUN.NOT_READY",
          "REPORTS.RUN.EXPIRED"
        ],
        "security": [{ "bearerAuth": [] }],
        "x-permissions": ["reports:read"]
      }
    }
  },
  "components": {
    "schemas": {
      "ReportType": {
        "type": "string",
        "enum": [
          "tasks_by_status",
          "tasks_activity",
          "invoices_summary",
          "notifications_delivery"
        ],
        "description": "Report type."
      },
      "ReportRunStatus": {
        "type": "string",
        "enum": ["queued", "running", "ready", "failed", "expired"],
        "description": "Status of a report run."
      },
      "ReportFormat": {
        "type": "string",
        "enum": ["json", "csv"],
        "description": "Format of a report."
      },
      "ReportGranularity": {
        "type": "string",
        "enum": ["day", "week", "month"],
        "description": "Time granularity of a report."
      },
      "RunCompletedPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "runId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/ReportType" },
          "status": { "$ref": "#/components/schemas/ReportRunStatus" },
          "requestedBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "completedAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          }
        },
        "required": [
          "tenantId",
          "runId",
          "type",
          "status",
          "requestedBy",
          "completedAt"
        ],
        "description": "A report run finished."
      },
      "ExecuteRunPayload": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "runId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["tenantId", "runId"],
        "additionalProperties": false,
        "description": "Resumes a report run in a worker."
      },
      "ReportColumnKind": {
        "type": "string",
        "enum": ["text", "integer", "date"],
        "description": "Data type of a result column."
      },
      "ReportParams": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/CalendarDate"
          },
          "to": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/CalendarDate"
          },
          "granularity": { "$ref": "#/components/schemas/ReportGranularity" }
        },
        "required": ["from", "to", "granularity"],
        "additionalProperties": false,
        "description": "Date range and granularity of a report."
      },
      "ReportColumn": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 64 },
          "header": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kind": { "$ref": "#/components/schemas/ReportColumnKind" }
        },
        "required": ["key", "header", "kind"],
        "description": "Column of a report result."
      },
      "ReportRow": {
        "type": "object",
        "properties": {
          "cells": {
            "maxItems": 20,
            "type": "array",
            "items": { "type": "string", "maxLength": 1000 }
          }
        },
        "required": ["cells"],
        "description": "Row of a report result."
      },
      "ReportResult": {
        "type": "object",
        "properties": {
          "columns": {
            "maxItems": 20,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportColumn" }
          },
          "rows": {
            "maxItems": 10000,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportRow" }
          }
        },
        "required": ["columns", "rows"],
        "description": "Tabular result of a finished run."
      },
      "ReportCatalogEntry": {
        "type": "object",
        "properties": {
          "type": { "$ref": "#/components/schemas/ReportType" },
          "formats": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportFormat" }
          },
          "granularities": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportGranularity" }
          }
        },
        "required": ["type", "formats", "granularities"],
        "description": "Available report type, with its formats and granularities."
      },
      "ReportCatalog": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 20,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportCatalogEntry" }
          }
        },
        "required": ["items"],
        "description": "Catalog of reports the tenant can request."
      },
      "CreateReportRunRequest": {
        "type": "object",
        "properties": {
          "type": { "$ref": "#/components/schemas/ReportType" },
          "format": { "$ref": "#/components/schemas/ReportFormat" },
          "params": { "$ref": "#/components/schemas/ReportParams" }
        },
        "required": ["type", "format", "params"],
        "additionalProperties": false,
        "description": "Request for a report run."
      },
      "ReportRunCreated": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["runId"],
        "description": "Run accepted; its result is queried by id."
      },
      "ReportRunSummary": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/ReportType" },
          "status": { "$ref": "#/components/schemas/ReportRunStatus" },
          "format": { "$ref": "#/components/schemas/ReportFormat" },
          "params": { "$ref": "#/components/schemas/ReportParams" },
          "requestedBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "completedAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          },
          "expiresAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "format",
          "params",
          "requestedBy",
          "createdAt",
          "completedAt",
          "expiresAt"
        ],
        "description": "Report run without its result."
      },
      "ReportRunPage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportRunSummary" }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "description": "Page of report runs."
      },
      "ListReportRunsRequest": {
        "type": "object",
        "properties": {
          "type": { "$ref": "#/components/schemas/ReportType" },
          "status": { "$ref": "#/components/schemas/ReportRunStatus" },
          "limit": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/PageLimit"
          },
          "after": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Cursor"
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination of the run listing."
      },
      "GetReportRunRequest": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["runId"],
        "additionalProperties": false,
        "description": "Report run to query."
      },
      "ReportRunDetail": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "type": { "$ref": "#/components/schemas/ReportType" },
          "status": { "$ref": "#/components/schemas/ReportRunStatus" },
          "format": { "$ref": "#/components/schemas/ReportFormat" },
          "params": { "$ref": "#/components/schemas/ReportParams" },
          "requestedBy": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          },
          "createdAt": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
          },
          "completedAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          },
          "expiresAt": {
            "anyOf": [
              {
                "$ref": "../../platform/export/openapi.json#/components/schemas/Timestamp"
              },
              { "type": "null" }
            ]
          },
          "result": {
            "anyOf": [
              { "$ref": "#/components/schemas/ReportResult" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "format",
          "params",
          "requestedBy",
          "createdAt",
          "completedAt",
          "expiresAt",
          "result"
        ],
        "description": "Report run with its result, null until it is ready."
      },
      "DownloadReportRunRequest": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          }
        },
        "required": ["runId"],
        "additionalProperties": false,
        "description": "Report run whose result is downloaded."
      },
      "ReportDownload": {
        "type": "object",
        "properties": {
          "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "contentType": { "type": "string", "minLength": 1, "maxLength": 100 },
          "content": { "type": "string", "maxLength": 8000000 }
        },
        "required": ["fileName", "contentType", "content"],
        "description": "Content of a report ready to download."
      },
      "EraseReportsUserInput": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/UserRef"
          }
        },
        "required": ["user"],
        "additionalProperties": false,
        "description": "User whose data is deleted from reports."
      },
      "EraseReportsUserResult": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "../../platform/export/openapi.json#/components/schemas/Id"
          },
          "affectedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["userId", "affectedRows"],
        "description": "Reports rows that stopped storing the user."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
