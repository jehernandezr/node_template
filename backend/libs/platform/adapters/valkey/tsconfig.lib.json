{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../sharding/tsconfig.lib.json"
    },
    {
      "path": "../../primitives/tsconfig.lib.json"
    },
    {
      "path": "../../kernel/tsconfig.lib.json"
    },
    {
      "path": "../../cache/tsconfig.lib.json"
    },
    {
      "path": "../../bloom/tsconfig.lib.json"
    },
    {
      "path": "../../resilience/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cjs",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
