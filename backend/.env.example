# Environment variables for local development.
# Copy to .env: cp backend/.env.example backend/.env
# The values are local development placeholders. Do not use real credentials.
#
# The names are the same ones the Terraform service stack provides in AWS and the ones
# validated by the configuration schemas of @platform/config and of each adapter. Only
# the values change: locally there is no TLS, IAM or database proxy.

# --- Application (baseConfigSchema of @platform/config) ---
NODE_ENV=development
SERVICE_NAME=identity
# Deployed environment: local, dev, staging or prod. Travels in traces as
# deployment.environment.name and decides which providers the configuration accepts (ADR 0046);
# NODE_ENV is production in every AWS environment and decides none of them.
DEPLOY_ENVIRONMENT=local

# --- Logs ---
# Levels: debug, info, warn, error
LOG_LEVEL=info
# Share of requests that log at debug (0.01 = 1%)
LOG_SAMPLE_RATE=0.01
# Debug only for specific modules, comma separated (example: auth,reports)
# LOG_DEBUG_CONTEXTS=

# --- PostgreSQL (docker compose) ---
# In AWS, DB_PROXY_HOST is the RDS Proxy and DB_READER_HOSTS the replicas (comma separated).
DB_PROXY_HOST=localhost
DB_READER_HOSTS=
DB_PORT=5432
# Service databases: shards and, if it uses one, the catalog (JSON, same as in Terraform).
DB_DATABASES={"shards":["identity_shard_0","identity_shard_1"],"catalog":"catalog"}
# User and password (JSON). On Fargate it comes from Secrets Manager with this same
# name. The Lambda runtime does not resolve secrets yet: it needs DB_CREDENTIALS in its environment.
DB_CREDENTIALS={"username":"platform","password":"platform"}
# Queries slower than this threshold (in ms) are always logged
DB_SLOW_QUERY_MS=500
# Logs every query (only for local debugging)
DB_LOG_QUERIES=false

# --- Valkey (valkeyConfigSchema of @platform/adapters-valkey) ---
# Locally it connects by URL and without authentication. In AWS it gets VALKEY_HOST, VALKEY_PORT,
# VALKEY_TLS=true, VALKEY_USER, VALKEY_AUTH=iam-serverless and VALKEY_CACHE_NAME.
VALKEY_URL=redis://localhost:6379
# Prefix of all the service keys and channels. In AWS the ACL only allows
# <prefix>:*, so there is no default value.
VALKEY_KEY_PREFIX=identity

# --- AWS / LocalStack (awsConfigSchema of @platform/adapters-aws) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack account, to build the topic ARNs (in AWS Terraform provides it)
AWS_ACCOUNT_ID=000000000000
# Prefix of the physical topic and queue names (Terraform name_prefix)
MESSAGING_NAME_PREFIX=local

# --- Observability (OpenTelemetry Collector and OpenObserve, docker compose) ---
# Turns off the OpenTelemetry SDK. With the SDK off, logs go out as JSON on stdout;
# with it on, they go over OTLP to the Collector.
OTEL_SDK_DISABLED=false
# OTLP HTTP endpoint of the Collector, which samples and forwards to OpenObserve. The
# OpenTelemetry exporters read it directly; the SDK appends /v1/traces, /v1/metrics and /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Exporter headers as comma-separated key=value pairs. Locally the
# Collector already authenticates against OpenObserve; they are used when sending directly to a backend.
# OTEL_EXPORTER_OTLP_HEADERS=
# Metrics export interval in ms
# OTEL_METRIC_EXPORT_INTERVAL=60000

# --- Identity (config of backend/apps/identity) ---
# Development secrets are placeholders: generate each one with `openssl rand -base64 32`.
# AUTH_ISSUER must equal IDENTITY_ISSUER.
# AUTH_JWKS_URL points to identity's own /v1/auth/jwks.
# IDENTITY_MAILER: memory or console only with DEPLOY_ENVIRONMENT=local; dev, staging and prod require notifications (ADR 0046).
IDENTITY_REGION=local
IDENTITY_ISSUER=http://localhost:3000
AUTH_ISSUER=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/v1/auth/jwks
# Access token audiences: api and backoffice, comma separated.
IDENTITY_AUDIENCES=api
# List of private ES256 JWKs with kid and status. CHANGE_ME_SIGNING_KEYS
IDENTITY_SIGNING_KEYS=CHANGE_ME_SIGNING_KEYS
IDENTITY_EMAIL_PEPPER=CHANGE_ME_EMAIL_PEPPER
IDENTITY_TOKEN_PEPPER=CHANGE_ME_TOKEN_PEPPER
IDENTITY_API_KEY_PEPPER=CHANGE_ME_API_KEY_PEPPER
IDENTITY_DEVICE_ID_KEY=CHANGE_ME_DEVICE_ID_KEY
IDENTITY_DATA_KEY=CHANGE_ME_DATA_KEY
# Seed only, rejected with DEPLOY_ENVIRONMENT=prod: the smoke account as JSON with email, password and a Base32 TOTP secret.
# When set, `identity:seed` creates or resets it (ADR 0043). Unset by default.
# IDENTITY_SMOKE_ACCOUNT=
INTERNAL_API_SHARED_SECRET=CHANGE_ME_INTERNAL_API_SECRET
# Signer of outgoing internal calls: hmac (with the secret above) or sigv4 (service role,
# requires the AWS adapter). INTERNAL_API_SIGV4_SERVICE picks the AWS service that signs.
INTERNAL_API_SIGNER=hmac
INTERNAL_API_SIGV4_SERVICE=execute-api
ACCESS_TOKEN_TTL=10m
SESSION_IDLE_TTL=1d
SESSION_ABSOLUTE_TTL=30d
IDENTITY_DEFAULT_TENANT_ID=018f0000-0000-7000-8000-0000000000a1
IDENTITY_PLATFORM_TENANT_ID=018f0000-0000-7000-8000-0000000000a2
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Identity local
WEBAUTHN_ORIGINS=http://localhost:5173
MFA_RECOVERY_BASE_HOURS=24
API_KEY_ROTATION_GRACE_HOURS=24
IDENTITY_MAILER=memory
# Allowed web origins (CORS and Origin policy) and trusted proxy hops.
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# --- Internal API between services ---
# Internal API address of each service this one calls (JSON). They all answer on the
# same path, so each one needs its own URL; locally, each service runs on its PORT.
# identity calls billing, notifications, tasks and reports (sign-up and account deletion sagas and
# user quota); tasks calls identity and billing (quotas); reports calls identity, tasks and
# billing (access and projection backfill). Without a URL the service requires, it does not start.
INTERNAL_API_BASE_URLS={"identity":"http://localhost:3000","tasks":"http://localhost:3001","notifications":"http://localhost:3002","reports":"http://localhost:3003","billing":"http://localhost:3004"}

# --- Billing (config of backend/apps/billing) ---
# Trial days of a new tenant and grace days of a past-due subscription before suspending it.
# They are required and have no default: they are a business decision.
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
# Invoice number series (FAC-000001) and the plan the trial starts on.
BILLING_INVOICE_SERIES=FAC
BILLING_TRIAL_PLAN=inicio
# Payment provider: fake or none. none never charges and leaves every invoice issued; staging and prod
# require it, dev accepts both. The fake outcome: approved, declined or pending (waits for mark-paid or mark-failed).
BILLING_PAYMENT_PROVIDER=fake
BILLING_FAKE_PAYMENT_OUTCOME=approved

# --- Reports (config of backend/apps/reports) ---
# Maximum size of a run result (bytes of its JSON), where it is stored (only row, in
# report_runs) and how many days it is kept.
REPORTS_MAX_RESULT_BYTES=1000000
REPORTS_RESULT_STORE=row
REPORTS_RESULT_TTL_DAYS=30

# --- Regions (@platform/service) ---
# Deployment regions (JSON): code, API URL and token issuer. Empty: a single region.
# A tenant from another region gets 421 with its API URL. With SERVICE_REGION declared,
# AUTH_ISSUER must be that region's issuer, and identity requires IDENTITY_REGION=SERVICE_REGION.
# Locally, region B runs each service again with SERVICE_REGION=local-b.
# REGIONS=[{"code":"local","apiBaseUrl":"http://localhost:3000","issuer":"http://localhost:3000"},{"code":"local-b","apiBaseUrl":"http://localhost:3100","issuer":"http://localhost:3100"}]
# SERVICE_REGION=local

# --- Tenant move (@platform/service and @platform/tenant-move) ---
# Where the write gate of a moving tenant is closed: directory or valkey.
TENANT_WRITE_GATE=directory
# How long a write waits with the gate closed before answering TENANT_MIGRATING (ms).
TENANT_MOVE_MAX_WAIT_MS=5000
# Shard groups (JSON): the region and logical shard of the service in each group. They are used to move
# tenants and so each service records a new tenant in the same group identity chose. A shard
# with no declared group has as group its name without the service prefix (identity_shard_0 is shard_0).
# TENANT_MOVE_TARGETS={"local-b-0":{"region":"local-b","shard":"identity_shard_0"}}
# Days the source keeps the data of a moved tenant before cleaning it up.
TENANT_MOVE_GRACE_DAYS=7
# Deadline of the move saga; if it passes before the pivot, it compensates and the tenant writes to the source again.
TENANT_MOVE_DEADLINE_MS=21600000
# Copy: batch (batches and delta rounds) or logical-replication (requires wal_level=logical on the source).
TENANT_MOVE_STRATEGY=batch
# Rows per batch, working time of each call (ms) and look-back margin of each delta round (ms).
TENANT_MOVE_BATCH_SIZE=500
TENANT_MOVE_CALL_BUDGET_MS=4000
TENANT_MOVE_DELTA_MARGIN_MS=60000
# Rows changed in a round below which the copy counts as caught up.
TENANT_MOVE_CAUGHT_UP_ROWS=50
# With logical replication: pending WAL (bytes) to count it as caught up, maximum wait for the
# REPLICA IDENTITY lock (ms) and, if needed, how the target reaches the source.
TENANT_MOVE_CAUGHT_UP_BYTES=1048576
TENANT_MOVE_LOCK_TIMEOUT_MS=2000
# TENANT_MOVE_REPLICATION_HOST=
# TENANT_MOVE_REPLICATION_PORT=
