# Variables de entorno para desarrollo local.
# Copiar a .env: cp .env.example .env
# Los valores son placeholders de desarrollo local. No usar credenciales reales.

# --- Aplicación ---
NODE_ENV=development
SERVICE_NAME=local-service

# --- Logs ---
# Niveles: debug, info, warn, error
LOG_LEVEL=info
# Porcentaje de requests que loguean en debug (0.01 = 1%)
LOG_SAMPLE_RATE=0.01
# Debug solo para módulos específicos, separados por coma (ejemplo: auth,reports)
# LOG_DEBUG_CONTEXTS=

# --- PostgreSQL (docker compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=platform
DB_PASSWORD=platform
DB_CATALOG_NAME=catalog
# Queries más lentas que este umbral (en ms) se registran siempre
DB_SLOW_QUERY_MS=500
# Registra cada query (solo para depurar en local)
DB_LOG_QUERIES=false

# --- Valkey (docker compose) ---
VALKEY_URL=redis://localhost:6379

# --- AWS / LocalStack (los lee el adaptador de AWS) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Cuenta de LocalStack, para armar los ARN de los tópicos
AWS_ACCOUNT_ID=000000000000
# Prefijo de los nombres físicos de tópicos y colas (name_prefix de Terraform)
MESSAGING_NAME_PREFIX=platform-local

# --- SMTP (Mailpit, docker compose) ---
# La UI de los correos está en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Observabilidad (OpenTelemetry hacia OpenObserve, docker compose) ---
# Apaga el SDK de OpenTelemetry (los logs JSON siguen saliendo por stdout)
OTEL_SDK_DISABLED=false
# Endpoint OTLP HTTP; el SDK agrega /v1/traces, /v1/metrics y /v1/logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
# Encabezados del exportador en formato clave=valor separados por coma,
# por ejemplo la autenticación de OpenObserve: Authorization=Basic <base64 usuario:clave>
# OTEL_EXPORTER_OTLP_HEADERS=
# Intervalo de export de métricas en ms
# OTEL_METRIC_EXPORT_INTERVAL=60000
