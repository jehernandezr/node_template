# Variables de entorno para desarrollo local.
# Copiar a .env: cp .env.example .env
# Los valores son placeholders de desarrollo local. No usar credenciales reales.

# --- Aplicación ---
NODE_ENV=development
SERVICE_NAME=local-service

# --- Logs ---
# Niveles: debug, info, warn, error
LOG_LEVEL=info
# Porcentaje de requests que loguean en debug (0.01 = 1%)
LOG_SAMPLE_RATE=0.01
# Debug solo para módulos específicos, separados por coma (ejemplo: auth,reports)
# LOG_DEBUG_CONTEXTS=

# --- PostgreSQL (docker compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=platform
DB_PASSWORD=platform
DB_CATALOG_NAME=catalog
# Queries más lentas que este umbral (en ms) se registran siempre
DB_SLOW_QUERY_MS=500

# --- Valkey (docker compose) ---
VALKEY_URL=redis://localhost:6379

# --- AWS / LocalStack ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- SMTP (Mailpit, docker compose) ---
# La UI de los correos está en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Observabilidad (OpenObserve, docker compose) ---
# Endpoint OTLP HTTP de OpenObserve
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
