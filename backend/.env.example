# Variables de entorno para desarrollo local.
# Copiar a .env: cp backend/.env.example backend/.env
# Los valores son placeholders de desarrollo local. No usar credenciales reales.
#
# Los nombres son los mismos que el stack service de Terraform entrega en AWS y los que
# validan los esquemas de configuración de @platform/config y de cada adaptador. Solo
# cambian los valores: en local no hay TLS, IAM ni proxy de base de datos.

# --- Aplicación (baseConfigSchema de @platform/config) ---
NODE_ENV=development
SERVICE_NAME=identity
# Ambiente desplegado: local, dev, staging o prod. Viaja en las trazas como
# deployment.environment.name (NODE_ENV vale production en todos los ambientes de AWS).
DEPLOY_ENVIRONMENT=local

# --- Logs ---
# Niveles: debug, info, warn, error
LOG_LEVEL=info
# Porcentaje de requests que loguean en debug (0.01 = 1%)
LOG_SAMPLE_RATE=0.01
# Debug solo para módulos específicos, separados por coma (ejemplo: auth,reports)
# LOG_DEBUG_CONTEXTS=

# --- PostgreSQL (docker compose) ---
# En AWS, DB_PROXY_HOST es el RDS Proxy y DB_READER_HOSTS las réplicas (separadas por coma).
DB_PROXY_HOST=localhost
DB_READER_HOSTS=
DB_PORT=5432
# Bases del servicio: shards y, si lo usa, el catálogo (JSON, igual que en Terraform).
DB_DATABASES={"shards":["identity_shard_0","identity_shard_1"],"catalog":"catalog"}
# Usuario y contraseña (JSON). En Fargate llega desde Secrets Manager con este mismo
# nombre; en Lambda llega DB_SECRET_ARN y el servicio lee el secreto al arrancar.
DB_CREDENTIALS={"username":"platform","password":"platform"}
# Queries más lentas que este umbral (en ms) se registran siempre
DB_SLOW_QUERY_MS=500
# Registra cada query (solo para depurar en local)
DB_LOG_QUERIES=false

# --- Valkey (valkeyConfigSchema de @platform/adapters-valkey) ---
# En local se conecta por URL y sin autenticación. En AWS llegan VALKEY_HOST, VALKEY_PORT,
# VALKEY_TLS=true, VALKEY_USER, VALKEY_AUTH=iam-serverless y VALKEY_CACHE_NAME.
VALKEY_URL=redis://localhost:6379
# Prefijo de todas las llaves y canales del servicio. En AWS la ACL solo permite
# <prefijo>:*, así que no hay valor por defecto.
VALKEY_KEY_PREFIX=identity

# --- AWS / LocalStack (awsConfigSchema de @platform/adapters-aws) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Cuenta de LocalStack, para armar los ARN de los tópicos (en AWS la entrega Terraform)
AWS_ACCOUNT_ID=000000000000
# Prefijo de los nombres físicos de tópicos y colas (name_prefix de Terraform)
MESSAGING_NAME_PREFIX=local

# --- Observabilidad (OpenTelemetry Collector y OpenObserve, docker compose) ---
# Apaga el SDK de OpenTelemetry. Con el SDK apagado los logs salen como JSON por stdout;
# encendido, salen por OTLP hacia el Collector.
OTEL_SDK_DISABLED=false
# Endpoint OTLP HTTP del Collector, que muestrea y reenvía a OpenObserve. Lo leen los
# exportadores de OpenTelemetry directamente; el SDK agrega /v1/traces, /v1/metrics y /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Encabezados del exportador en formato clave=valor separados por coma. En local el
# Collector ya autentica contra OpenObserve; se usan al enviar directo a un backend.
# OTEL_EXPORTER_OTLP_HEADERS=
# Intervalo de export de métricas en ms
# OTEL_METRIC_EXPORT_INTERVAL=60000

# --- Identity (config de backend/apps/identity) ---
# Los secretos de desarrollo son marcadores: genera cada uno con `openssl rand -base64 32`.
# AUTH_ISSUER debe ser igual a IDENTITY_ISSUER.
# AUTH_JWKS_URL apunta al /v1/auth/jwks del propio identity.
# IDENTITY_MAILER=console solo con NODE_ENV=development; en otro ambiente la config falla.
IDENTITY_REGION=local
IDENTITY_ISSUER=http://localhost:3000
AUTH_ISSUER=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/v1/auth/jwks
# Audiencias del access token: api y backoffice, separadas por coma.
IDENTITY_AUDIENCES=api
# Lista de JWK privados ES256 con kid y estado. CAMBIAR_CLAVES_DE_FIRMA
IDENTITY_SIGNING_KEYS=CAMBIAR_CLAVES_DE_FIRMA
IDENTITY_EMAIL_PEPPER=CAMBIAR_PIMIENTA_DE_EMAIL
IDENTITY_TOKEN_PEPPER=CAMBIAR_PIMIENTA_DE_TOKENS
IDENTITY_API_KEY_PEPPER=CAMBIAR_PIMIENTA_DE_API_KEYS
IDENTITY_DEVICE_ID_KEY=CAMBIAR_CLAVE_DE_DEVICE_ID
IDENTITY_DATA_KEY=CAMBIAR_CLAVE_DE_CIFRADO
INTERNAL_API_SHARED_SECRET=CAMBIAR_SECRETO_API_INTERNA
# Firmador de las llamadas internas que salen: hmac (con el secreto de arriba) o sigv4 (rol del
# servicio, exige el adaptador de AWS). INTERNAL_API_SIGV4_SERVICE elige el servicio de AWS que firma.
INTERNAL_API_SIGNER=hmac
INTERNAL_API_SIGV4_SERVICE=execute-api
ACCESS_TOKEN_TTL=10m
SESSION_IDLE_TTL=1d
SESSION_ABSOLUTE_TTL=30d
IDENTITY_DEFAULT_TENANT_ID=018f0000-0000-7000-8000-0000000000a1
IDENTITY_PLATFORM_TENANT_ID=018f0000-0000-7000-8000-0000000000a2
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Identity local
WEBAUTHN_ORIGINS=http://localhost:5173
MFA_RECOVERY_BASE_HOURS=24
API_KEY_ROTATION_GRACE_HOURS=24
IDENTITY_MAILER=memory
# Orígenes web permitidos (CORS y política de Origin) y saltos de proxy de confianza.
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# --- API interna entre servicios ---
# Dirección de la API interna de cada servicio al que este llama (JSON). Todos responden en el
# mismo path, así que cada uno necesita su propia URL; en local, cada servicio corre en su PORT.
# identity llama a billing, notifications, tasks y reports (sagas de alta y de borrado de cuenta y
# cuota de usuarios); tasks llama a identity y billing (cuotas); reports llama a identity, tasks y
# billing (acceso y relleno de proyecciones). Sin una URL que el servicio exige, no arranca.
INTERNAL_API_BASE_URLS={"identity":"http://localhost:3000","tasks":"http://localhost:3001","notifications":"http://localhost:3002","reports":"http://localhost:3003","billing":"http://localhost:3004"}

# --- Billing (config de backend/apps/billing) ---
# Días de prueba de un tenant nuevo y de gracia de una suscripción morosa antes de suspenderla.
# Son obligatorios y sin valor por defecto: son una decisión comercial.
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
# Serie de los números de factura (FAC-000001) y plan con el que abre la prueba.
BILLING_INVOICE_SERIES=FAC
BILLING_TRIAL_PLAN=inicio
# Proveedor de cobro: solo fake. Su resultado: approved, declined o pending (espera mark-paid o mark-failed).
BILLING_PAYMENT_PROVIDER=fake
BILLING_FAKE_PAYMENT_OUTCOME=approved

# --- Reports (config de backend/apps/reports) ---
# Tamaño máximo del resultado de una ejecución (bytes de su JSON), dónde se guarda (solo row, en
# report_runs) y cuántos días se conserva.
REPORTS_MAX_RESULT_BYTES=1000000
REPORTS_RESULT_STORE=row
REPORTS_RESULT_TTL_DAYS=30

# --- Regiones (@platform/service) ---
# Regiones del despliegue (JSON): código, URL de su API y emisor de sus tokens. Vacío: una sola región.
# Un tenant de otra región responde 421 con la URL de su API. Con SERVICE_REGION declarada,
# AUTH_ISSUER debe ser el issuer de esa región, e identity exige IDENTITY_REGION=SERVICE_REGION.
# En local, la región B corre cada servicio otra vez con SERVICE_REGION=local-b.
# REGIONS=[{"code":"local","apiBaseUrl":"http://localhost:3000","issuer":"http://localhost:3000"},{"code":"local-b","apiBaseUrl":"http://localhost:3100","issuer":"http://localhost:3100"}]
# SERVICE_REGION=local

# --- Traslado de tenants (@platform/service y @platform/tenant-move) ---
# Dónde se cierra la compuerta de escritura de un tenant que se traslada: directory o valkey.
TENANT_WRITE_GATE=directory
# Cuánto espera una escritura con la compuerta cerrada antes de responder TENANT_MIGRATING (ms).
TENANT_MOVE_MAX_WAIT_MS=5000
# Grupos de shards (JSON): la región y el shard lógico del servicio en cada grupo. Sirven para trasladar
# tenants y para que cada servicio anote un tenant nuevo en el mismo grupo que eligió identity. Un shard
# sin grupo declarado tiene por grupo su nombre sin el prefijo del servicio (identity_shard_0 es shard_0).
# TENANT_MOVE_TARGETS={"local-b-0":{"region":"local-b","shard":"identity_shard_0"}}
# Días que el origen conserva los datos de un tenant trasladado antes de limpiarlo.
TENANT_MOVE_GRACE_DAYS=7
# Copia: batch (lotes y rondas delta) o logical-replication (pide wal_level=logical en el origen).
TENANT_MOVE_STRATEGY=batch
# Filas por lote, tiempo de trabajo de cada llamada (ms) y margen hacia atrás de cada ronda delta (ms).
TENANT_MOVE_BATCH_SIZE=500
TENANT_MOVE_CALL_BUDGET_MS=4000
TENANT_MOVE_DELTA_MARGIN_MS=60000
# Filas cambiadas en una ronda por debajo de las cuales la copia se da por alcanzada.
TENANT_MOVE_CAUGHT_UP_ROWS=50
# Con replicación lógica: WAL pendiente (bytes) para darla por alcanzada, espera máxima por el candado
# de REPLICA IDENTITY (ms) y, si hace falta, cómo llega el destino al origen.
TENANT_MOVE_CAUGHT_UP_BYTES=1048576
TENANT_MOVE_LOCK_TIMEOUT_MS=2000
# TENANT_MOVE_REPLICATION_HOST=
# TENANT_MOVE_REPLICATION_PORT=
