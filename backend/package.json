{
  "name": "@node-template/backend",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "External dependencies of the backend. The libraries, apps and tools in backend/ have no package.json of their own: they are imported through TypeScript aliases.",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1160.0",
    "@aws-sdk/client-sns": "3.1160.0",
    "@aws-sdk/client-sqs": "3.1160.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.79.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@simplewebauthn/server": "14.0.3",
    "@smithy/signature-v4": "5.7.5",
    "iovalkey": "0.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "tslib": "2.9.1",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.3.2",
    "@nx/eslint-plugin": "24.0.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "0.2.39",
    "@testcontainers/postgresql": "12.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.3.0",
    "jest-environment-node": "30.3.0",
    "jest-util": "30.3.0",
    "prettier": "3.10.0",
    "socket.io-client": "4.8.4",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "nx": {
    "name": "backend-tooling",
    "tags": [
      "type:tooling"
    ],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint --config eslint.tooling.config.mjs .claude/skills .claude/hooks .claude/guards .claude/impact front/tools backend/infra/scripts --ignore-pattern \"**/build/**\"",
          "cwd": "{workspaceRoot}"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/eslint.tooling.config.mjs",
          "{workspaceRoot}/backend/eslint.comments.mjs",
          "{workspaceRoot}/.claude/skills/**/*",
          "{workspaceRoot}/.claude/hooks/**/*",
          "{workspaceRoot}/.claude/guards/**/*",
          "{workspaceRoot}/.claude/impact/**/*",
          "{workspaceRoot}/front/tools/**/*",
          "{workspaceRoot}/backend/infra/scripts/**/*.mjs"
        ]
      },
      "tooling-test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test .claude/guards/__tests__/*.test.mjs .claude/impact/__tests__/*.test.mjs .claude/skills/backend-structure/scripts/*.test.mjs .claude/skills/front-structure/scripts/__tests__/*.test.mjs .claude/skills/front-structure/scripts/rules/__tests__/*.test.mjs",
          "cwd": "{workspaceRoot}"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.claude/**/*",
          "{workspaceRoot}/CLAUDE.md",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/backend/tsconfig.base.json",
          "{workspaceRoot}/docs/quality/**/*",
          "{workspaceRoot}/backend/eslint.*",
          "{workspaceRoot}/eslint.tooling.config.mjs",
          "{workspaceRoot}/commitlint.config.mjs"
        ]
      }
    }
  }
}
