final class Scripted{{Pascal}}Repository implements {{Pascal}}Repository {
  /// One completer per call to `list`, in call order.
  final List<Completer<List<{{Pascal}}Item>>> lists = [];

  /// One completer per call to `get`, in call order.
  final List<Completer<{{Pascal}}Item>> gets = [];

  @override
  Future<List<{{Pascal}}Item>> list() {
    final completer = Completer<List<{{Pascal}}Item>>();
